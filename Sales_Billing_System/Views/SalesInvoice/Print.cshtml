@model Sales_Billing_System.Models.Sales_Invoice

@{
    Layout = null;

    ViewBag.Title = "Print Invoice";
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width,
                   initial-scale=1.0" />

    <title>
        Invoice - @Model.InvoiceNumber
    </title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <style>

        body
        {
            background: white;
        }


        .invoice-container
        {
            max-width: 900px;
            margin: 30px auto;
        }


        .company-title
        {
            font-size: 28px;
            font-weight: bold;
        }


        @media print
        {
            .no-print
            {
                display: none !important;
            }

            body
            {
                margin: 0;
            }

            .invoice-container
            {
                margin: 0;
                max-width: 100%;
            }
        }

    </style>

</head>


<body>

    <div class="container invoice-container">

        <!-- Print Button -->
        <div class="text-end mb-4 no-print">

            <button onclick="window.print()"
                    class="btn btn-primary">

                Print Invoice

            </button>


            @Html.ActionLink(
                "Back",
                "Details",
                "SalesInvoice",
                new { id = Model.InvoiceId },
                new { @class = "btn btn-secondary ms-2" }
            )

        </div>


        <!-- Company -->
        <div class="row mb-4">

            <div class="col-md-6">

                <div class="company-title">

                    SALES BILLING SYSTEM

                </div>

                <p class="text-muted">

                    Sales Invoice

                </p>

            </div>


            <div class="col-md-6 text-md-end">

                <h4>

                    INVOICE

                </h4>

                <p class="mb-1">

                    <strong>
                        Invoice No:
                    </strong>

                    @Model.InvoiceNumber

                </p>

                <p>

                    <strong>
                        Date:
                    </strong>

                    @Model.InvoiceDate
                    .ToString("dd-MM-yyyy")

                </p>

            </div>

        </div>


        <hr />


        <!-- Customer -->
        <div class="row mb-4">

            <div class="col-md-6">

                <h6>

                    Bill To

                </h6>


                <strong>

                    @(Model.Customer != null
                        ? Model.Customer.CustomerName
                        : "")

                </strong>


                <p class="mb-1">

                    @(Model.Customer != null
                        ? Model.Customer.Address
                        : "")

                </p>


                <p class="mb-1">

                    @(Model.Customer != null
                        ? Model.Customer.MobileNumber
                        : "")

                </p>


                @if (
                    Model.Customer != null &&
                    !string.IsNullOrWhiteSpace(
                        Model.Customer.GSTIN
                    )
                )
                {
                    <p>

                        GSTIN:
                        @Model.Customer.GSTIN

                    </p>
                }

            </div>

        </div>


        <!-- Items -->
        <table class="table table-bordered">

            <thead class="table-light">

                <tr>

                    <th>#</th>

                    <th>
                        Product
                    </th>

                    <th>
                        Qty
                    </th>

                    <th>
                        Rate
                    </th>

                    <th>
                        GST %
                    </th>

                    <th>
                        Taxable Amount
                    </th>

                    <th>
                        GST Amount
                    </th>

                    <th>
                        Total
                    </th>

                </tr>

            </thead>


            <tbody>

                @{
                    int count = 1;
                }


                @foreach (
                    var item in Model.InvoiceItems
                )
                {
                    <tr>

                        <td>
                            @count
                        </td>


                        <td>

                            @(item.Product != null
                                ? item.Product.ProductName
                                : "")

                        </td>


                        <td>

                            @item.Quantity
                            .ToString("N2")

                        </td>


                        <td>

                            ₹@item.Rate
                            .ToString("N2")

                        </td>


                        <td>

                            @item.GSTPercentage%

                        </td>


                        <td>

                            ₹@item.TaxableAmount
                            .ToString("N2")

                        </td>


                        <td>

                            ₹@item.GSTAmount
                            .ToString("N2")

                        </td>


                        <td>

                            ₹@item.TotalAmount
                            .ToString("N2")

                        </td>

                    </tr>

                    count++;
                }

            </tbody>

        </table>


        <!-- Totals -->
        <div class="row justify-content-end">

            <div class="col-md-5">

                <table class="table">

                    <tr>

                        <th>
                            Total Taxable Amount
                        </th>

                        <td class="text-end">

                            ₹@Model.TotalTaxableAmount
                            .ToString("N2")

                        </td>

                    </tr>


                    <tr>

                        <th>
                            Total GST Amount
                        </th>

                        <td class="text-end">

                            ₹@Model.TotalGSTAmount
                            .ToString("N2")

                        </td>

                    </tr>


                    <tr class="table-light">

                        <th>

                            <h5>
                                Grand Total
                            </h5>

                        </th>

                        <td class="text-end">

                            <h5>

                                ₹@Model.GrandTotal
                                .ToString("N2")

                            </h5>

                        </td>

                    </tr>

                </table>

            </div>

        </div>


        <hr />


        <!-- Footer -->
        <div class="text-center mt-4">

            <p class="mb-1">

                Thank you for your business!

            </p>

            <small class="text-muted">

                This is a system generated invoice.

            </small>

        </div>

    </div>

</body>

</html>