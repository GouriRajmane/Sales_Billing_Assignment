@model Sales_Billing_System.Models.Sales_Invoice

@{
    Layout = null;
    ViewBag.Title = "Print Invoice";
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Invoice - @Model.InvoiceNumber
    </title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            font-family: "Courier New", Courier, monospace;
            color: #333;
        }


        /* Main Invoice Container */

        .invoice-wrapper {
            width: 100%;
            padding: 30px 15px;
        }


        .invoice-container {
            width: 900px;
            max-width: 100%;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 35px 40px;
        }


        /* Company Section */

        .company-section {
            text-align: center;
            margin-bottom: 35px;
        }


        .company-name {
            font-size: 22px;
            font-weight: bold;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }


        .invoice-title {
            font-size: 16px;
            letter-spacing: 1px;
            font-weight: bold;
        }


        /* Invoice Details */

        .invoice-info {
            margin-bottom: 30px;
            line-height: 1.8;
            font-size: 15px;
        }


        .label {
            display: inline-block;
            width: 120px;
            font-weight: bold;
        }


        /* Customer Section */

        .customer-section {
            margin-bottom: 30px;
            line-height: 1.8;
            font-size: 15px;
        }


        .customer-label {
            font-weight: bold;
            margin-bottom: 5px;
        }


        /* Dashed Line */

        .separator {
            border: 0;
            border-top: 1px dashed #333;
            margin: 20px 0;
        }


        /* Invoice Items */

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 12px;
        }


            .invoice-table th {
                padding: 10px 5px;
                font-weight: bold;
                border-bottom: 1px solid #333;
                vertical-align: bottom;
            }


            .invoice-table td {
                padding: 10px 5px;
                vertical-align: top;
                word-wrap: break-word;
            }


        .text-center {
            text-align: center;
        }


        .text-right {
            text-align: right;
        }


        /* Totals */

        .totals-section {
            width: 100%;
            margin-top: 20px;
            font-size: 15px;
        }


        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
        }


        .total-label {
            font-weight: bold;
        }


        .grand-total {
            font-size: 17px;
            font-weight: bold;
            padding-top: 10px;
        }


        /* Print Controls */

        .print-actions {
            width: 900px;
            max-width: 100%;
            margin: 0 auto 20px auto;
            text-align: right;
        }


        .btn {
            padding: 8px 16px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            text-decoration: none;
            display: inline-block;
            border-radius: 4px;
            margin-left: 5px;
        }


        .btn-print {
            background-color: #0d6efd;
            color: white;
        }


        .btn-back {
            background-color: #6c757d;
            color: white;
        }


        /* Print Settings */

        @@media print {

            body {
                background-color: white;
            }


            .no-print {
                display: none !important;
            }


            .invoice-wrapper {
                padding: 0;
            }


            .invoice-container {
                width: 100%;
                max-width: 100%;
                padding: 0;
                margin: 0;
            }


            @@page {
                size: A4 landscape;
                margin: 15mm;
            }
        }


        /* Mobile */

        @@media (max-width: 768px) {

            .invoice-container {
                padding: 25px 15px;
            }


            .company-name {
                font-size: 19px;
            }


            .invoice-table {
                font-size: 10px;
            }


                .invoice-table th,
                .invoice-table td {
                    padding: 6px 3px;
                }
        }
    </style>

</head>


<body>


    <!-- Buttons -->

    <div class="print-actions no-print">

        <button type="button"
                class="btn btn-print"
                onclick="window.print()">

            Print Invoice

        </button>


        @Html.ActionLink(
            "Back",
            "Details",
            "SalesInvoice",
            new { id = Model.InvoiceId },
            new
            {
                @class = "btn btn-back"
            }
        )

    </div>


    <div class="invoice-wrapper">


        <div class="invoice-container">


            <!-- Company Name -->

            <div class="company-section">

                <div class="company-name">
                    VILANIMART
                </div>


                <div class="invoice-title">
                    SALES INVOICE
                </div>

            </div>


            <!-- Invoice Details -->

            <div class="invoice-info">

                <div>

                    <span class="label">
                        Invoice No:
                    </span>

                    @Model.InvoiceNumber

                </div>


                <div>

                    <span class="label">
                        Date:
                    </span>

                    @(Model.InvoiceDate.ToString("dd-MMM-yyyy"))

                </div>

            </div>


            <!-- Customer Details -->

            <div class="customer-section">

                <div class="customer-label">
                    Customer:
                </div>


                <div>
                    @(Model.Customer != null
                        ? Model.Customer.CustomerName
                        : "")
                </div>


                <div>
                    @(Model.Customer != null
                        ? Model.Customer.Address
                        : "")
                </div>


                @if (Model.Customer != null &&
                     !string.IsNullOrWhiteSpace(Model.Customer.MobileNumber))
                {
                    <div>
                        Mobile:
                        @Model.Customer.MobileNumber
                    </div>
                }


                @if (Model.Customer != null &&
                     !string.IsNullOrWhiteSpace(Model.Customer.GSTIN))
                {
                    <div>
                        GSTIN:
                        @Model.Customer.GSTIN
                    </div>
                }

            </div>


            <hr class="separator" />


            <!-- Invoice Items -->

            <table class="invoice-table">

                <colgroup>

                    <col style="width: 20%;" />

                    <col style="width: 8%;" />

                    <col style="width: 12%;" />

                    <col style="width: 12%;" />

                    <col style="width: 8%;" />

                    <col style="width: 20%;" />

                    <col style="width: 20%;" />

                </colgroup>


                <thead>

                    <tr>

                        <th>
                            Product
                        </th>


                        <th class="text-center">
                            Qty
                        </th>


                        <th class="text-right">
                            Rate
                        </th>


                        <th class="text-right">
                            Discount
                        </th>


                        <th class="text-center">
                            GST %
                        </th>


                        <th class="text-right">
                            Taxable Amount
                        </th>


                        <th class="text-right">
                            Amount
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model.InvoiceItems)
                    {
                        <tr>

                            <!-- Product -->

                            <td>
                                @(item.Product != null
                                    ? item.Product.ProductName
                                    : "")
                            </td>


                            <!-- Quantity -->

                            <td class="text-center">
                                @(item.Quantity.ToString("N2"))
                            </td>


                            <!-- Rate -->

                            <td class="text-right">
                                ₹@(item.Rate.ToString("N2"))
                            </td>


                            <!-- Discount -->

                            <td class="text-right">
                                ₹@(item.Discount.ToString("N2"))
                            </td>


                            <!-- GST -->

                            <td class="text-center">
                                @(item.GSTPercentage.ToString("N2"))%
                            </td>


                            <!-- Taxable Amount -->

                            <td class="text-right">
                                ₹@(item.TaxableAmount.ToString("N2"))
                            </td>


                            <!-- Total Amount -->

                            <td class="text-right">
                                ₹@(item.TotalAmount.ToString("N2"))
                            </td>

                        </tr>
                    }

                </tbody>

            </table>


            <hr class="separator" />


            <!-- Totals -->

            <div class="totals-section">


                <div class="total-row">

                    <span class="total-label">
                        Total Taxable Amount:
                    </span>


                    <span>
                        ₹@(Model.TotalTaxableAmount.ToString("N2"))
                    </span>

                </div>


                <div class="total-row">

                    <span class="total-label">
                        Total GST Amount:
                    </span>


                    <span>
                        ₹@(Model.TotalGSTAmount.ToString("N2"))
                    </span>

                </div>


                <hr class="separator" />


                <div class="total-row grand-total">

                    <span>
                        Grand Total:
                    </span>


                    <span>
                        ₹@(Model.GrandTotal.ToString("N2"))
                    </span>

                </div>


            </div>


        </div>


    </div>


</body>

</html>