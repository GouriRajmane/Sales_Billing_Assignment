@model Sales_Billing_System.Models.Sales_Invoice

@using (Html.BeginForm("Cancel", "SalesInvoice", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.InvoiceId" />

    <div class="modal-header bg-dark text-white">
        <h5 class="modal-title mb-0">Cancel Invoice</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <p class="mb-1">Are you sure you want to <strong>cancel</strong> this invoice?</p>
        <p class="mb-0 text-muted">
            @Model.InvoiceNumber &mdash; ₹@(Model.GrandTotal.ToString("N2"))
        </p>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, Keep Invoice</button>
        <button type="submit" class="btn btn-danger">Yes, Cancel Invoice</button>
    </div>
}