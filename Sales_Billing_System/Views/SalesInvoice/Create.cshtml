@model Sales_Billing_System.Models.SalesInvoiceViewModel
@using System.Globalization
@using System.Linq

@using (Html.BeginForm("Create", "SalesInvoice", FormMethod.Post, new { id = "invoiceForm" }))
{
    @Html.AntiForgeryToken()

    <div class="modal-header bg-success text-white">
        <div>
            <h5 class="modal-title mb-0">Create Sales Invoice</h5>
            <small class="text-white">Create a new sales invoice and add multiple products.</small>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <!-- INVOICE INFORMATION -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success-50 text-dark"><h6 class="mb-0">Invoice Information</h6></div>
            <div class="card-body">
                <div class="row">

                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(m => m.InvoiceNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.InvoiceNumber, new { @class = "form-control", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.InvoiceNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(m => m.InvoiceDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.InvoiceDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.InvoiceDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(m => m.CustomerId, "Customer", new { @class = "form-label fw-bold" })
                        <select id="CustomerId" name="CustomerId" class="form-select lazy-select"
                                data-url="@Url.Action("SearchCustomers", "SalesInvoice")"
                                data-placeholder="Search customer..."
                                data-val="true" data-val-required="Please select a customer.">
                            <option></option>
                            @if (Model.CustomerId > 0)
                            {
                                <option value="@Model.CustomerId" selected>@Request["CustomerText"]</option>
                            }
                        </select>
                        <input type="hidden" id="CustomerText" name="CustomerText" value="@Request["CustomerText"]" />
                        @Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })
                    </div>

                </div>
            </div>
        </div>

        <!-- INVOICE ITEMS -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success-50 text-dark d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Invoice Items</h6>
                <button type="button" id="addItemBtn" class="btn btn-outline-success btn-sm">+ Add Product</button>
            </div>

            <div class="card-body">
                <div id="itemError" class="alert alert-danger d-none" role="alert"></div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-hover align-middle" id="invoiceItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="min-width:240px;">Product</th>
                                <th style="min-width:100px;">Quantity</th>
                                <th style="min-width:120px;">Rate (₹)</th>
                                <th style="min-width:100px;">GST %</th>
                                <th style="min-width:140px;">Taxable Amount (₹)</th>
                                <th style="min-width:130px;">GST Amount (₹)</th>
                                <th style="min-width:140px;">Total Amount (₹)</th>
                                <th style="min-width:90px;">Action</th>
                            </tr>
                        </thead>

                        <tbody id="invoiceItemsBody">
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    var it = Model.Items[i];
                                    var pText = Request["Items[" + i + "].ProductText"];
                                    <tr class="invoice-item-row">
                                        <td>
                                            <select name="Items[@i].ProductId" class="form-select lazy-select product-select"
                                                    data-url="@Url.Action("SearchProducts", "SalesInvoice")"
                                                    data-placeholder="Search product..." required>
                                                <option></option>
                                                @if (it.ProductId > 0)
                                                {
                                                    <option value="@it.ProductId" selected>@pText</option>
                                                }
                                            </select>
                                            <input type="hidden" name="Items[@i].ProductText" class="product-text" value="@pText" />
                                        </td>
                                        <td><input type="number" name="Items[@i].Quantity" class="form-control quantity" value="@(it.Quantity <= 0 ? "1" : it.Quantity.ToString("0.##", CultureInfo.InvariantCulture))" step="1" min="1" required /></td>
                                        <td><input type="number" name="Items[@i].Rate" class="form-control rate" value="@it.Rate.ToString("0.00", CultureInfo.InvariantCulture)" step="0.01" min="0" required /></td>
                                        <td><input type="number" name="Items[@i].GSTPercentage" class="form-control gst" value="@it.GSTPercentage.ToString("0.##", CultureInfo.InvariantCulture)" step="0.01" min="0" max="100" required /></td>
                                        <td>
                                            <input type="text" class="form-control taxable-amount" value="@it.TaxableAmount.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
                                            <input type="hidden" name="Items[@i].TaxableAmount" class="taxable-hidden" value="@it.TaxableAmount.ToString("0.00", CultureInfo.InvariantCulture)" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control gst-amount" value="@it.GSTAmount.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
                                            <input type="hidden" name="Items[@i].GSTAmount" class="gst-hidden" value="@it.GSTAmount.ToString("0.00", CultureInfo.InvariantCulture)" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control total-amount" value="@it.TotalAmount.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
                                            <input type="hidden" name="Items[@i].TotalAmount" class="total-hidden" value="@it.TotalAmount.ToString("0.00", CultureInfo.InvariantCulture)" />
                                        </td>
                                        <td class="text-center"><button type="button" class="btn btn-danger btn-sm remove-item">Remove</button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <small class="text-muted">
                    Type to search a product; its rate and GST are filled automatically.
                    Quantity, rate and GST can be adjusted before saving.
                </small>
            </div>
        </div>

        <!-- INVOICE SUMMARY -->
        <div class="row justify-content-end">
            <div class="col-md-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-light"><h6 class="mb-0">Invoice Summary</h6></div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3"><strong>Total Taxable Amount</strong><span id="totalTaxableAmount">₹0.00</span></div>
                        <div class="d-flex justify-content-between mb-3"><strong>Total GST Amount</strong><span id="totalGSTAmount">₹0.00</span></div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Grand Total</h5>
                            <h5 class="mb-0 text-success" id="grandTotal">₹0.00</h5>
                        </div>
                        <input type="hidden" id="TotalTaxableAmount" name="TotalTaxableAmount" value="0.00" />
                        <input type="hidden" id="TotalGSTAmount" name="TotalGSTAmount" value="0.00" />
                        <input type="hidden" id="GrandTotal" name="GrandTotal" value="0.00" />
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Save Invoice</button>
    </div>
}

<script>
    (function () {

        var form = document.getElementById("invoiceForm");
        var itemsBody = document.getElementById("invoiceItemsBody");
        var itemError = document.getElementById("itemError");
        var itemIndex = itemsBody.querySelectorAll("tr").length;
        var productUrl = '@Url.Action("SearchProducts", "SalesInvoice")';

        function roundMoney(v) { return Math.round((v + Number.EPSILON) * 100) / 100; }
        function formatRupees(v) { return "₹" + Number(v).toFixed(2); }
        function showError(m) { itemError.textContent = m; itemError.classList.remove("d-none"); }
        function clearError() { itemError.textContent = ""; itemError.classList.add("d-none"); }

        // ---------- LAZY SELECT (same pattern as Product page) ----------
        function initLazy($el) {
            $el.select2({
                theme: "bootstrap-5",
                width: "100%",
                dropdownParent: $("#appModal"),
                placeholder: $el.data("placeholder"),
                allowClear: true,
                minimumInputLength: 1,
                language: {
                    inputTooShort: function () { return $el.data("placeholder"); },
                    searching: function () { return "Searching..."; },
                    noResults: function () { return "No results found"; }
                },
                ajax: {
                    url: $el.data("url"),
                    delay: 300,
                    cache: false,
                    data: function (p) { return { term: p.term }; },
                    processResults: function (d) { return { results: d }; }
                }
            });
        }

        $("#invoiceForm .lazy-select").each(function () { initLazy($(this)); });

        // Product picked -> fill rate and GST
        $(itemsBody).on("select2:select", ".product-select", function (e) {
            var row = this.closest("tr"), d = e.params.data;
            row.querySelector(".rate").value = Number(d.rate).toFixed(2);
            row.querySelector(".gst").value = Number(d.gst).toFixed(2);
            calculateInvoiceTotals();
        });

        $(itemsBody).on("select2:clear", ".product-select", function () {
            var row = this.closest("tr");
            row.querySelector(".rate").value = "0.00";
            row.querySelector(".gst").value = "0.00";
            calculateInvoiceTotals();
        });

        // ---------- CALCULATIONS ----------
        function calculateRow(row) {
            var qty = parseFloat(row.querySelector(".quantity").value) || 0;
            var rate = parseFloat(row.querySelector(".rate").value) || 0;
            var gstPct = parseFloat(row.querySelector(".gst").value) || 0;

            var taxable = roundMoney(qty * rate);
            var gst = roundMoney(taxable * gstPct / 100);
            var total = roundMoney(taxable + gst);

            row.querySelector(".taxable-amount").value = row.querySelector(".taxable-hidden").value = taxable.toFixed(2);
            row.querySelector(".gst-amount").value = row.querySelector(".gst-hidden").value = gst.toFixed(2);
            row.querySelector(".total-amount").value = row.querySelector(".total-hidden").value = total.toFixed(2);

            return { taxable: taxable, gst: gst };
        }

        function calculateInvoiceTotals() {
            var totalTaxable = 0, totalGST = 0;

            itemsBody.querySelectorAll("tr").forEach(function (row) {
                var r = calculateRow(row);
                totalTaxable += r.taxable;
                totalGST += r.gst;
            });

            totalTaxable = roundMoney(totalTaxable);
            totalGST = roundMoney(totalGST);
            var grand = roundMoney(totalTaxable + totalGST);

            document.getElementById("totalTaxableAmount").textContent = formatRupees(totalTaxable);
            document.getElementById("totalGSTAmount").textContent = formatRupees(totalGST);
            document.getElementById("grandTotal").textContent = formatRupees(grand);
            document.getElementById("TotalTaxableAmount").value = totalTaxable.toFixed(2);
            document.getElementById("TotalGSTAmount").value = totalGST.toFixed(2);
            document.getElementById("GrandTotal").value = grand.toFixed(2);
        }

        // ---------- ROWS ----------
        function addNewRow() {
            var n = itemIndex, row = document.createElement("tr");
            row.className = "invoice-item-row";
            row.innerHTML =
                '<td><select name="Items[' + n + '].ProductId" class="form-select lazy-select product-select" data-url="' + productUrl + '" data-placeholder="Search product..." required><option></option></select>' +
                '<input type="hidden" name="Items[' + n + '].ProductText" class="product-text" value="" /></td>' +
                '<td><input type="number" name="Items[' + n + '].Quantity" class="form-control quantity" value="1" step="0.01" min="0.01" required /></td>' +
                '<td><input type="number" name="Items[' + n + '].Rate" class="form-control rate" value="0.00" step="0.01" min="0" required /></td>' +
                '<td><input type="number" name="Items[' + n + '].GSTPercentage" class="form-control gst" value="0.00" step="0.01" min="0" max="100" required /></td>' +
                '<td><input type="text" class="form-control taxable-amount" value="0.00" readonly /><input type="hidden" name="Items[' + n + '].TaxableAmount" class="taxable-hidden" value="0.00" /></td>' +
                '<td><input type="text" class="form-control gst-amount" value="0.00" readonly /><input type="hidden" name="Items[' + n + '].GSTAmount" class="gst-hidden" value="0.00" /></td>' +
                '<td><input type="text" class="form-control total-amount" value="0.00" readonly /><input type="hidden" name="Items[' + n + '].TotalAmount" class="total-hidden" value="0.00" /></td>' +
                '<td class="text-center"><button type="button" class="btn btn-danger btn-sm remove-item">Remove</button></td>';

            itemsBody.appendChild(row);
            initLazy($(row).find(".lazy-select"));
            itemIndex++;
            calculateInvoiceTotals();
        }

        function updateItemIndexes() {
            var rows = itemsBody.querySelectorAll("tr");
            rows.forEach(function (row, index) {
                row.querySelectorAll("input, select").forEach(function (el) {
                    var name = el.getAttribute("name");
                    if (name) el.setAttribute("name", name.replace(/Items\[\d+\]/g, "Items[" + index + "]"));
                });
            });
            itemIndex = rows.length;
        }

        document.getElementById("addItemBtn").addEventListener("click", addNewRow);

        itemsBody.addEventListener("input", function (e) {
            var c = e.target.classList;
            if (c.contains("quantity") || c.contains("rate") || c.contains("gst")) calculateInvoiceTotals();
        });

        itemsBody.addEventListener("click", function (e) {
            if (!e.target.classList.contains("remove-item")) return;

            if (itemsBody.querySelectorAll("tr").length <= 1) {
                showError("At least one invoice item is required.");
                return;
            }

            var row = e.target.closest("tr");
            $(row).find(".lazy-select").select2("destroy");
            row.remove();
            updateItemIndexes();
            clearError();
            calculateInvoiceTotals();
        });

        // ---------- SUBMIT (runs before the shared AJAX handler) ----------
        form.addEventListener("submit", function (event) {

            function stop(msg) {
                event.preventDefault();
                event.stopPropagation();
                showError(msg);
            }

            clearError();

            var $cust = $("#CustomerId");
            if (!$cust.val()) { stop("Please search and select a customer."); return; }

            var rows = itemsBody.querySelectorAll("tr");
            if (rows.length === 0) { stop("Please add at least one invoice item."); return; }

            var invalid = false;
            rows.forEach(function (row) {
                var qty = parseFloat(row.querySelector(".quantity").value);
                var rate = parseFloat(row.querySelector(".rate").value);
                var gst = parseFloat(row.querySelector(".gst").value);

                if (!$(row).find(".product-select").val() || isNaN(qty) || qty <= 0 ||
                    isNaN(rate) || rate < 0 || isNaN(gst) || gst < 0 || gst > 100) {
                    invalid = true;
                }
            });

            if (invalid) { stop("Please search and select a product, and enter valid quantity, rate and GST for every row."); return; }

            // Keep selected names so they survive a failed server-side save
            document.getElementById("CustomerText").value = $cust.find("option:selected").text();
            rows.forEach(function (row) {
                row.querySelector(".product-text").value = $(row).find(".product-select option:selected").text();
            });

            calculateInvoiceTotals();
        });

        calculateInvoiceTotals();

    })();
</script>