@model Sales_Billing_System.Models.SalesInvoiceViewModel

@{
    ViewBag.Title = "Create Sales Invoice";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Create Sales Invoice</h2>

            <p class="text-muted mb-0">
                Create a new sales invoice and add multiple products.
            </p>
        </div>

        @Html.ActionLink(
            "Back to Invoices",
            "Index",
            "SalesInvoice",
            null,
            new { @class = "btn btn-secondary" }
        )

    </div>


    @using (Html.BeginForm(
        "Create",
        "SalesInvoice",
        FormMethod.Post,
        new { id = "invoiceForm" }
    ))
    {
        @Html.AntiForgeryToken()


        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger mb-3" }
        )


        <!-- Invoice Header -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-dark text-white">

                <h5 class="mb-0">
                    Invoice Information
                </h5>

            </div>


            <div class="card-body">

                <div class="row">

                    <!-- Invoice Number -->
                    <div class="col-md-4 mb-3">

                        @Html.LabelFor(
                            model => model.InvoiceNumber,
                            new { @class = "form-label fw-bold" }
                        )

                        @Html.TextBoxFor(
                            model => model.InvoiceNumber,
                            new
                            {
                                @class = "form-control",
                                @readonly = "readonly"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.InvoiceNumber,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- Invoice Date -->
                    <div class="col-md-4 mb-3">

                        @Html.LabelFor(
                            model => model.InvoiceDate,
                            new { @class = "form-label fw-bold" }
                        )

                        @Html.TextBoxFor(
                            model => model.InvoiceDate,
                            "{0:yyyy-MM-dd}",
                            new
                            {
                                @class = "form-control",
                                type = "date"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.InvoiceDate,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- Customer -->
                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-bold">
                            Customer
                        </label>

                        @Html.DropDownListFor(
                            model => model.CustomerId,
                            ViewBag.Customers as SelectList,
                            "-- Select Customer --",
                            new
                            {
                                @class = "form-select"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.CustomerId,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>

            </div>

        </div>


        <!-- Invoice Items -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Invoice Items
                </h5>

                <button type="button"
                        id="addItemBtn"
                        class="btn btn-light btn-sm">

                    + Add Product

                </button>

            </div>


            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered align-middle"
                           id="invoiceItemsTable">

                        <thead class="table-light">

                            <tr>

                                <th style="min-width:200px;">
                                    Product
                                </th>

                                <th style="min-width:100px;">
                                    Quantity
                                </th>

                                <th style="min-width:120px;">
                                    Rate
                                </th>

                                <th style="min-width:100px;">
                                    GST %
                                </th>

                                <th style="min-width:130px;">
                                    Taxable Amount
                                </th>

                                <th style="min-width:120px;">
                                    GST Amount
                                </th>

                                <th style="min-width:130px;">
                                    Total Amount
                                </th>

                                <th style="width:100px;">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody id="invoiceItemsBody">

                            @if (Model.Items != null && Model.Items.Any())
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr class="invoice-item-row">

                                        <!-- Product -->
                                        <td>

                                            @Html.DropDownList(
                                                "Items[" + i + "].ProductId",
                                                ViewBag.Products as SelectList,
                                                "-- Select Product --",
                                                new
                                                {
                                                    @class = "form-select product-select"
                                                }
                                            )

                                        </td>


                                        <!-- Quantity -->
                                        <td>

                                            @Html.TextBox(
                                                "Items[" + i + "].Quantity",
                                                Model.Items[i].Quantity,
                                                new
                                                {
                                                    @class = "form-control quantity",
                                                    type = "number",
                                                    step = "0.01",
                                                    min = "0.01"
                                                }
                                            )

                                        </td>


                                        <!-- Rate -->
                                        <td>

                                            @Html.TextBox(
                                                "Items[" + i + "].Rate",
                                                Model.Items[i].Rate,
                                                new
                                                {
                                                    @class = "form-control rate",
                                                    type = "number",
                                                    step = "0.01",
                                                    min = "0"
                                                }
                                            )

                                        </td>


                                        <!-- GST -->
                                        <td>

                                            @Html.TextBox(
                                                "Items[" + i + "].GSTPercentage",
                                                Model.Items[i].GSTPercentage,
                                                new
                                                {
                                                    @class = "form-control gst",
                                                    type = "number",
                                                    step = "0.01",
                                                    min = "0",
                                                    max = "100"
                                                }
                                            )

                                        </td>


                                        <!-- Taxable Amount -->
                                        <td>

                                            <input type="text"
                                                   class="form-control taxable-amount"
                                                   readonly />

                                        </td>


                                        <!-- GST Amount -->
                                        <td>

                                            <input type="text"
                                                   class="form-control gst-amount"
                                                   readonly />

                                        </td>


                                        <!-- Total Amount -->
                                        <td>

                                            <input type="text"
                                                   class="form-control total-amount"
                                                   readonly />

                                        </td>


                                        <!-- Delete -->
                                        <td class="text-center">

                                            <button type="button"
                                                    class="btn btn-danger btn-sm remove-item">

                                                Remove

                                            </button>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- Invoice Totals -->
        <div class="row justify-content-end mb-4">

            <div class="col-md-5">

                <div class="card shadow-sm">

                    <div class="card-header bg-light">

                        <h5 class="mb-0">
                            Invoice Summary
                        </h5>

                    </div>


                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <strong>
                                Total Taxable Amount
                            </strong>

                            <span id="totalTaxableAmount">
                                ₹0.00
                            </span>

                        </div>


                        <div class="d-flex justify-content-between mb-3">

                            <strong>
                                Total GST Amount
                            </strong>

                            <span id="totalGSTAmount">
                                ₹0.00
                            </span>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between">

                            <h5>
                                Grand Total
                            </h5>

                            <h5 id="grandTotal">
                                ₹0.00
                            </h5>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Buttons -->
        <div class="mb-5">

            <button type="submit"
                    class="btn btn-primary">

                Save Invoice

            </button>


            @Html.ActionLink(
                "Cancel",
                "Index",
                "SalesInvoice",
                null,
                new { @class = "btn btn-secondary ms-2" }
            )

        </div>

    }

</div>


@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>

        $(document).ready(function () {

            var itemIndex = $("#invoiceItemsBody tr").length;


            // Add New Item
            $("#addItemBtn").click(function () {

                var newRow = `
                    <tr class="invoice-item-row">

                        <td>

                            <select name="Items[${itemIndex}].ProductId"
                                    class="form-select product-select">

                                <option value="">
                                    -- Select Product --
                                </option>

                                @if (ViewBag.Products != null)
                                {
                                    foreach (var product in ViewBag.Products as SelectList)
                                    {
                                        <option value="@product.Value">
                                            @product.Text
                                        </option>
                                    }
                                }

                            </select>

                        </td>


                        <td>

                            <input type="number"
                                   name="Items[${itemIndex}].Quantity"
                                   class="form-control quantity"
                                   value="1"
                                   step="0.01"
                                   min="0.01" />

                        </td>


                        <td>

                            <input type="number"
                                   name="Items[${itemIndex}].Rate"
                                   class="form-control rate"
                                   value="0"
                                   step="0.01"
                                   min="0" />

                        </td>


                        <td>

                            <input type="number"
                                   name="Items[${itemIndex}].GSTPercentage"
                                   class="form-control gst"
                                   value="0"
                                   step="0.01"
                                   min="0"
                                   max="100" />

                        </td>


                        <td>

                            <input type="text"
                                   class="form-control taxable-amount"
                                   readonly />

                        </td>


                        <td>

                            <input type="text"
                                   class="form-control gst-amount"
                                   readonly />

                        </td>


                        <td>

                            <input type="text"
                                   class="form-control total-amount"
                                   readonly />

                        </td>


                        <td class="text-center">

                            <button type="button"
                                    class="btn btn-danger btn-sm remove-item">

                                Remove

                            </button>

                        </td>

                    </tr>
                `;


                $("#invoiceItemsBody").append(newRow);

                itemIndex++;

                calculateInvoiceTotals();

            });


            // Remove Item
            $(document).on(
                "click",
                ".remove-item",
                function () {

                    var rowCount =
                        $("#invoiceItemsBody tr").length;

                    if (rowCount <= 1) {

                        alert(
                            "At least one invoice item is required."
                        );

                        return;

                    }

                    $(this)
                        .closest("tr")
                        .remove();

                    updateItemIndexes();

                    calculateInvoiceTotals();

                }
            );


            // Calculate when values change
            $(document).on(
                "input",
                ".quantity, .rate, .gst",
                function () {

                    calculateInvoiceTotals();

                }
            );


            function calculateInvoiceTotals() {

                var totalTaxable = 0;

                var totalGST = 0;

                var grandTotal = 0;


                $("#invoiceItemsBody tr").each(
                    function () {

                        var row =
                            $(this);


                        var quantity =
                            parseFloat(
                                row.find(".quantity").val()
                            ) || 0;


                        var rate =
                            parseFloat(
                                row.find(".rate").val()
                            ) || 0;


                        var gstPercentage =
                            parseFloat(
                                row.find(".gst").val()
                            ) || 0;


                        // Taxable Amount
                        var taxableAmount =
                            quantity * rate;


                        // GST Amount
                        var gstAmount =
                            taxableAmount *
                            gstPercentage / 100;


                        // Total Amount
                        var totalAmount =
                            taxableAmount +
                            gstAmount;


                        row
                            .find(".taxable-amount")
                            .val(
                                taxableAmount.toFixed(2)
                            );


                        row
                            .find(".gst-amount")
                            .val(
                                gstAmount.toFixed(2)
                            );


                        row
                            .find(".total-amount")
                            .val(
                                totalAmount.toFixed(2)
                            );


                        totalTaxable +=
                            taxableAmount;


                        totalGST +=
                            gstAmount;


                        grandTotal +=
                            totalAmount;

                    }
                );


                $("#totalTaxableAmount")
                    .text(
                        "₹" +
                        totalTaxable.toFixed(2)
                    );


                $("#totalGSTAmount")
                    .text(
                        "₹" +
                        totalGST.toFixed(2)
                    );


                $("#grandTotal")
                    .text(
                        "₹" +
                        grandTotal.toFixed(2)
                    );

            }


            // Reindex items after deletion
            function updateItemIndexes() {

                $("#invoiceItemsBody tr").each(
                    function (index) {

                        $(this)
                            .find("input, select")
                            .each(
                                function () {

                                    var name =
                                        $(this).attr("name");

                                    if (name) {

                                        name =
                                            name.replace(
                                                /Items\[\d+\]/,
                                                "Items[" +
                                                index +
                                                "]"
                                            );

                                        $(this)
                                            .attr(
                                                "name",
                                                name
                                            );

                                    }

                                }
                            );

                    }
                );


                itemIndex =
                    $("#invoiceItemsBody tr").length;

            }


            // Initial Calculation
            calculateInvoiceTotals();

        });

    </script>
}