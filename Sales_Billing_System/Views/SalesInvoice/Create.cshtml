@model Sales_Billing_System.Models.SalesInvoiceViewModel

@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using System.Web.Mvc
@using Sales_Billing_System.Models

@using (Html.BeginForm("Create", "SalesInvoice", FormMethod.Post, new { id = "invoiceForm" }))
{
    @Html.AntiForgeryToken()

    <div class="modal-header bg-success text-white">
        <div>
            <h5 class="modal-title mb-0">Create Sales Invoice</h5>
            <small class="text-white">Create a new sales invoice and add multiple products.</small>
        </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>

    </div>

    <div class="modal-body">

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <!-- INVOICE INFORMATION -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success-50 text-dark">
                <h6 class="mb-0">Invoice Information</h6>
            </div>
            <div class="card-body">
                <div class="row">

                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(model => model.InvoiceNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(model => model.InvoiceNumber,
                            new { @class = "form-control", @readonly = "readonly" })
                        @Html.ValidationMessageFor(model => model.InvoiceNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(model => model.InvoiceDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(model => model.InvoiceDate, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(model => model.CustomerId, "Customer", new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(model => model.CustomerId, Model.Customers,
                            "-- Select Customer --",
                            new { @class = "form-select", id = "CustomerId" })
                        @Html.ValidationMessageFor(model => model.CustomerId, "", new { @class = "text-danger" })
                    </div>

                </div>
            </div>
        </div>

        <!-- INVOICE ITEMS -->
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success-50 text-dark d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Invoice Items</h6>
                <button type="button" id="addItemBtn" class="btn btn-outline-success btn-sm">+ Add Product</button>
            </div>

            <div class="card-body">

                <div id="itemError" class="alert alert-danger d-none" role="alert"></div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle" id="invoiceItemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="min-width:220px;">Product</th>
                                <th style="min-width:100px;">Quantity</th>
                                <th style="min-width:120px;">Rate (₹)</th>
                                <th style="min-width:100px;">GST %</th>
                                <th style="min-width:140px;">Taxable Amount (₹)</th>
                                <th style="min-width:130px;">GST Amount (₹)</th>
                                <th style="min-width:140px;">Total Amount (₹)</th>
                                <th style="min-width:90px;">Action</th>
                            </tr>
                        </thead>

                        <tbody id="invoiceItemsBody">

                            @if (Model.Items != null && Model.Items.Any())
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    var currentProductId = Model.Items[i].ProductId;

                                    <tr class="invoice-item-row">

                                        <td>
                                            <select name="Items[@i].ProductId"
                                                    class="form-select product-select"
                                                    required>
                                                <option value="">-- Select Product --</option>

                                                @if (Model.Products != null)
                                                {
                                                    foreach (Product_Master product in Model.Products)
                                                    {
                                                        var selected = product.ProductId == currentProductId;

                                                        <option value="@product.ProductId"
                                                                data-rate="@product.SellingPrice.ToString("0.00", CultureInfo.InvariantCulture)"
                                                                data-gst="@product.GSTPercentage.ToString("0.00", CultureInfo.InvariantCulture)"
                                                                @(selected ? "selected" : "")>
                                                            @product.ProductName
                                                        </option>
                                                    }
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <input type="number"
                                                   name="Items[@i].Quantity"
                                                   class="form-control quantity"
                                                   value="@(Model.Items[i].Quantity == 0 ? "1" : Model.Items[i].Quantity.ToString("1", CultureInfo.InvariantCulture))"
                                                   step="1" min="1" required />
                                        </td>

                                        <td>
                                            <input type="number"
                                                   name="Items[@i].Rate"
                                                   class="form-control rate"
                                                   value="@Model.Items[i].Rate.ToString("0.00", CultureInfo.InvariantCulture)"
                                                   step="0.01" min="0" required />
                                        </td>

                                        <td>
                                            <input type="number"
                                                   name="Items[@i].GSTPercentage"
                                                   class="form-control gst"
                                                   value="@Model.Items[i].GSTPercentage.ToString("0.##", CultureInfo.InvariantCulture)"
                                                   step="0.01" min="0" max="100" required />
                                        </td>

                                        <td>
                                            <input type="text" class="form-control taxable-amount"
                                                   value="@Model.Items[i].TaxableAmount.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
                                            <input type="hidden" name="Items[@i].TaxableAmount" class="taxable-hidden"
                                                   value="@Model.Items[i].TaxableAmount.ToString("0.00", CultureInfo.InvariantCulture)" />
                                        </td>

                                        <td>
                                            <input type="text" class="form-control gst-amount"
                                                   value="@Model.Items[i].GSTAmount.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
                                            <input type="hidden" name="Items[@i].GSTAmount" class="gst-hidden"
                                                   value="@Model.Items[i].GSTAmount.ToString("0.00", CultureInfo.InvariantCulture)" />
                                        </td>

                                        <td>
                                            <input type="text" class="form-control total-amount"
                                                   value="@Model.Items[i].TotalAmount.ToString("0.00", CultureInfo.InvariantCulture)" readonly />
                                            <input type="hidden" name="Items[@i].TotalAmount" class="total-hidden"
                                                   value="@Model.Items[i].TotalAmount.ToString("0.00", CultureInfo.InvariantCulture)" />
                                        </td>

                                        <td class="text-center">
                                            <button type="button" class="btn btn-danger btn-sm remove-item">Remove</button>
                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>
                    </table>
                </div>

                <small class="text-muted">
                    Select a product to automatically populate its rate and GST.
                    Quantity and GST can be adjusted before saving.
                </small>

            </div>
        </div>

        <!-- INVOICE SUMMARY -->
        <div class="row justify-content-end">
            <div class="col-md-5">
                <div class="card shadow-sm">

                    <div class="card-header bg-light">
                        <h6 class="mb-0">Invoice Summary</h6>
                    </div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total Taxable Amount</strong>
                            <span id="totalTaxableAmount">₹0.00</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total GST Amount</strong>
                            <span id="totalGSTAmount">₹0.00</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Grand Total</h5>
                            <h5 class="mb-0 text-success" id="grandTotal">₹0.00</h5>
                        </div>

                        <input type="hidden" id="TotalTaxableAmount" name="TotalTaxableAmount" value="0.00" />
                        <input type="hidden" id="TotalGSTAmount" name="TotalGSTAmount" value="0.00" />
                        <input type="hidden" id="GrandTotal" name="GrandTotal" value="0.00" />

                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success" id="saveInvoiceBtn">Save Invoice</button>
    </div>
}

<script>
    (function () {

        var itemsBody = document.getElementById("invoiceItemsBody");
        var addItemBtn = document.getElementById("addItemBtn");
        var invoiceForm = document.getElementById("invoiceForm");
        var itemError = document.getElementById("itemError");
        var itemIndex = itemsBody.querySelectorAll("tr").length;

        function roundMoney(value) {
            return Math.round((value + Number.EPSILON) * 100) / 100;
        }

        function formatRupees(value) {
            return "₹" + Number(value).toFixed(2);
        }

        function showError(message) {
            itemError.textContent = message;
            itemError.classList.remove("d-none");
        }

        function clearError() {
            itemError.textContent = "";
            itemError.classList.add("d-none");
        }

        // Calculate one row
        function calculateRow(row) {
            var quantity = parseFloat(row.querySelector(".quantity").value) || 0;
            var rate = parseFloat(row.querySelector(".rate").value) || 0;
            var gstPercentage = parseFloat(row.querySelector(".gst").value) || 0;

            var taxableAmount = roundMoney(quantity * rate);
            var gstAmount = roundMoney(taxableAmount * gstPercentage / 100);
            var totalAmount = roundMoney(taxableAmount + gstAmount);

            row.querySelector(".taxable-amount").value = taxableAmount.toFixed(2);
            row.querySelector(".gst-amount").value = gstAmount.toFixed(2);
            row.querySelector(".total-amount").value = totalAmount.toFixed(2);

            row.querySelector(".taxable-hidden").value = taxableAmount.toFixed(2);
            row.querySelector(".gst-hidden").value = gstAmount.toFixed(2);
            row.querySelector(".total-hidden").value = totalAmount.toFixed(2);

            return { taxable: taxableAmount, gst: gstAmount, total: totalAmount };
        }

        // Calculate complete invoice
        function calculateInvoiceTotals() {
            var totalTaxable = 0;
            var totalGST = 0;

            itemsBody.querySelectorAll("tr").forEach(function (row) {
                var result = calculateRow(row);
                totalTaxable += result.taxable;
                totalGST += result.gst;
            });

            totalTaxable = roundMoney(totalTaxable);
            totalGST = roundMoney(totalGST);
            var grandTotal = roundMoney(totalTaxable + totalGST);

            document.getElementById("totalTaxableAmount").textContent = formatRupees(totalTaxable);
            document.getElementById("totalGSTAmount").textContent = formatRupees(totalGST);
            document.getElementById("grandTotal").textContent = formatRupees(grandTotal);

            document.getElementById("TotalTaxableAmount").value = totalTaxable.toFixed(2);
            document.getElementById("TotalGSTAmount").value = totalGST.toFixed(2);
            document.getElementById("GrandTotal").value = grandTotal.toFixed(2);
        }

        // Product selection fills rate and GST
        function productChanged(selectElement) {
            var row = selectElement.closest("tr");
            var selectedOption = selectElement.options[selectElement.selectedIndex];

            if (!selectElement.value) {
                row.querySelector(".rate").value = "0.00";
                row.querySelector(".gst").value = "0.00";
                calculateInvoiceTotals();
                return;
            }

            row.querySelector(".rate").value = selectedOption.getAttribute("data-rate") || "0.00";
            row.querySelector(".gst").value = selectedOption.getAttribute("data-gst") || "0.00";

            calculateInvoiceTotals();
        }

        // Copy product options from the first row's dropdown
        function getProductOptions() {
            var firstSelect = itemsBody.querySelector(".product-select");
            if (!firstSelect) return "";

            var options = "";

            for (var i = 1; i < firstSelect.options.length; i++) {
                var option = firstSelect.options[i];
                var el = document.createElement("option");

                el.value = option.value;
                el.textContent = option.textContent.trim();
                el.setAttribute("data-rate", option.getAttribute("data-rate") || "0");
                el.setAttribute("data-gst", option.getAttribute("data-gst") || "0");

                options += el.outerHTML;
            }

            return options;
        }

        // Add new row
        function addNewRow() {
            var row = document.createElement("tr");
            row.className = "invoice-item-row";

            row.innerHTML =
                '<td>' +
                '<select name="Items[' + itemIndex + '].ProductId" class="form-select product-select" required>' +
                '<option value="">-- Select Product --</option>' + getProductOptions() +
                '</select>' +
                '</td>' +
                '<td><input type="number" name="Items[' + itemIndex + '].Quantity" class="form-control quantity" value="1" step="0.01" min="0.01" required /></td>' +
                '<td><input type="number" name="Items[' + itemIndex + '].Rate" class="form-control rate" value="0.00" step="0.01" min="0" required /></td>' +
                '<td><input type="number" name="Items[' + itemIndex + '].GSTPercentage" class="form-control gst" value="0.00" step="0.01" min="0" max="100" required /></td>' +
                '<td>' +
                '<input type="text" class="form-control taxable-amount" value="0.00" readonly />' +
                '<input type="hidden" name="Items[' + itemIndex + '].TaxableAmount" class="taxable-hidden" value="0.00" />' +
                '</td>' +
                '<td>' +
                '<input type="text" class="form-control gst-amount" value="0.00" readonly />' +
                '<input type="hidden" name="Items[' + itemIndex + '].GSTAmount" class="gst-hidden" value="0.00" />' +
                '</td>' +
                '<td>' +
                '<input type="text" class="form-control total-amount" value="0.00" readonly />' +
                '<input type="hidden" name="Items[' + itemIndex + '].TotalAmount" class="total-hidden" value="0.00" />' +
                '</td>' +
                '<td class="text-center"><button type="button" class="btn btn-danger btn-sm remove-item">Remove</button></td>';

            itemsBody.appendChild(row);
            itemIndex++;
            calculateInvoiceTotals();
        }

        // Re-index names after a row is removed
        function updateItemIndexes() {
            var rows = itemsBody.querySelectorAll("tr");

            rows.forEach(function (row, index) {
                row.querySelectorAll("input, select").forEach(function (element) {
                    var name = element.getAttribute("name");
                    if (!name) return;

                    element.setAttribute("name", name.replace(/Items\[\d+\]/g, "Items[" + index + "]"));
                });
            });

            itemIndex = rows.length;
        }

        addItemBtn.addEventListener("click", addNewRow);

        itemsBody.addEventListener("change", function (event) {
            if (event.target.classList.contains("product-select")) {
                productChanged(event.target);
            }
        });

        itemsBody.addEventListener("input", function (event) {
            var c = event.target.classList;
            if (c.contains("quantity") || c.contains("rate") || c.contains("gst")) {
                calculateInvoiceTotals();
            }
        });

        itemsBody.addEventListener("click", function (event) {
            if (!event.target.classList.contains("remove-item")) return;

            if (itemsBody.querySelectorAll("tr").length <= 1) {
                showError("At least one invoice item is required.");
                return;
            }

            event.target.closest("tr").remove();
            updateItemIndexes();
            clearError();
            calculateInvoiceTotals();
        });

        // Client-side validation before the shared AJAX submit runs
        invoiceForm.addEventListener("submit", function (event) {

            function stop(message) {
                event.preventDefault();
                event.stopPropagation();   // keeps the shared AJAX handler from running
                showError(message);
            }

            clearError();

            if (!document.getElementById("CustomerId").value) {
                stop("Please select a customer.");
                return;
            }

            var rows = itemsBody.querySelectorAll("tr");

            if (rows.length === 0) {
                stop("Please add at least one invoice item.");
                return;
            }

            var invalid = false;

            rows.forEach(function (row) {
                var product = row.querySelector(".product-select").value;
                var quantity = parseFloat(row.querySelector(".quantity").value);
                var rate = parseFloat(row.querySelector(".rate").value);
                var gst = parseFloat(row.querySelector(".gst").value);

                if (!product || isNaN(quantity) || quantity <= 0 ||
                    isNaN(rate) || rate < 0 ||
                    isNaN(gst) || gst < 0 || gst > 100) {
                    invalid = true;
                }
            });

            if (invalid) {
                stop("Please select a product and enter valid quantity, rate and GST values for every row.");
                return;
            }

            calculateInvoiceTotals();
        });

        calculateInvoiceTotals();

    })();
</script>