@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Sales_Invoice>
@using System.Linq

@{
    ViewBag.Title = "Sales Invoices";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Sales Invoice Record</h2>
            <p class="text-muted mb-0">Manage, search and view all sales invoices.</p>
        </div>
        <div>
            <button type="button"
                    class="btn btn-success btn-modal"
                    data-size="modal-xl"
                    data-url="@Url.Action("Create", "SalesInvoice")">
                + Create Invoice
            </button>
        </div>
    </div>

    <!-- Alert Placeholder -->
    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Search and Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "SalesInvoice", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label fw-bold">Search</label>
                        @Html.TextBox("searchText", ViewBag.SearchText as string,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Invoice number or customer name"
                            })
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">From Date</label>
                        <input type="date"
                               name="fromDate"
                               value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold">To Date</label>
                        <input type="date"
                               name="toDate"
                               value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>

                    <div class="col-md-1">
                        @Html.ActionLink("Reset", "Index", "SalesInvoice", null,
                            new { @class = "btn btn-secondary w-100" })
                    </div>

                </div>
            }
        </div>
    </div>

    <!-- Reloaded via AJAX after Create / Cancel -->
    <div id="invoiceListContainer">

        <!-- Invoice Table -->
        @*<div class="card shadow-sm">*@
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0  table-bordered">
                        <thead class="table-success" >
                            <tr>
                                <th>Sr. No.</th>
                                <th>Invoice Number</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Grand Total</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Items != null && Model.Items.Any())
                            {
                                int count = ((Model.CurrentPage - 1) * Model.PageSize) + 1;

                                foreach (var invoice in Model.Items)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td><strong>@invoice.InvoiceNumber</strong></td>
                                        <td>@invoice.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                        <td>@(invoice.Customer != null ? invoice.Customer.CustomerName : "")</td>
                                        <td>₹ @invoice.GrandTotal.ToString("N2")</td>
                                        <td>
                                            @if (invoice.Status == "Active")
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                        </td>
                                        <td class="text-center">

                                            <button type="button"
                                                    class="btn btn-sm btn-info me-1 btn-modal"
                                                    data-size="modal-xl"
                                                    data-url="@Url.Action("Details", "SalesInvoice", new { id = invoice.InvoiceId })">
                                                View
                                            </button>

                                            @Html.ActionLink("Print", "Print",
                                                new { id = invoice.InvoiceId },
                                                new { @class = "btn btn-sm btn-secondary me-1", target = "_blank" })

                                            @if (invoice.Status != "Cancelled")
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-danger btn-modal"
                                                        data-size="modal-md"
                                                        data-url="@Url.Action("ConfirmCancel", "SalesInvoice", new { id = invoice.InvoiceId })">
                                                    Cancel
                                                </button>
                                            }
                                        </td>
                                    </tr>

                                    count++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <div class="text-muted">
                                            <h5>No Invoices Found</h5>
                                            <p class="mb-0">No sales invoices are available.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        @*</div>*@

        <!-- Pagination -->
        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="row mt-4">

                <div class="col-md-6">
                    <p class="text-muted">
                        Showing
                        <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong>
                        -
                        <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))</strong>
                        of
                        <strong>@Model.TotalRecords</strong>
                        invoices
                    </p>
                </div>

                <div class="col-md-6 text-end">
                    <ul class="pagination justify-content-end">

                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Index", "SalesInvoice", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, searchText = ViewBag.SearchText, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                                    &laquo; Previous
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">&laquo; Previous</span>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", "SalesInvoice", new { page = i, pageSize = Model.PageSize, searchText = ViewBag.SearchText, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                                        @i
                                    </a>
                                </li>
                            }
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Index", "SalesInvoice", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, searchText = ViewBag.SearchText, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">
                                    Next &raquo;
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Next &raquo;</span>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        }

    </div> <!-- /invoiceListContainer -->

</div>

<!-- Shared Modal (Create / View / Cancel load here) -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {

            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog');
            var $content = $('#appModalContent');

            function parseForm() {
                var $form = $content.find('form');
                if ($form.length) {
                    $form.removeData('validator').removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse($form);
                }
            }

            function showAlert(message, type) {
                if (!message) return;

                $('#alertPlaceholder').html(
                    '<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show" role="alert">' +
                    $('<div>').text(message).html() +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '</div>');
            }

            // Open modal: load Create / Details / ConfirmCancel
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url');
                var size = $(this).data('size') || 'modal-lg';

                $.get(url)
                    .done(function (html) {
                        $dialog.removeClass('modal-sm modal-md modal-lg modal-xl').addClass(size);
                        $content.html(html);   // inline scripts in the partial run here
                        parseForm();
                        modal.show();
                    })
                    .fail(function () {
                        alert('Unable to load the form. Please try again.');
                    });
            });

            // Submit any form inside the modal via AJAX
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();

                var $form = $(this);
                if (!$form.valid()) return;

                var $btn = $form.find('[type=submit]').prop('disabled', true);

                $.post($form.attr('action'), $form.serialize())
                    .done(function (res) {
                        if (typeof res === 'object') {
                            modal.hide();
                            showAlert(res.message, res.success ? 'success' : 'danger');

                            if (res.success) {
                                $('#invoiceListContainer')
                                    .load(window.location.href + ' #invoiceListContainer > *');
                            }
                        }
                        else {
                            $content.html(res);
                            parseForm();
                        }
                    })
                    .fail(function () {
                        alert('Something went wrong. Please try again.');
                    })
                    .always(function () {
                        $btn.prop('disabled', false);
                    });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                $content.empty();
            });
        });
    </script>
}