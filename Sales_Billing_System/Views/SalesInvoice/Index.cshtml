@model IEnumerable<Sales_Billing_System.Models.Sales_Invoice>

@{
    ViewBag.Title = "Sales Invoices";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Sales Invoice Record
            </h2>

            <p class="text-muted mb-0">
                Manage, search and view all sales invoices.
            </p>
        </div>

        @Html.ActionLink(
            "+ Create Invoice",
            "Create",
            "SalesInvoice",
            null,
            new { @class = "btn btn-primary" }
        )

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search and Filters -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            @using (Html.BeginForm(
                "Index",
                "SalesInvoice",
                FormMethod.Get
            ))
            {
                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-md-5">

                        <label class="form-label fw-bold">
                            Search
                        </label>

                        @Html.TextBox(
                            "searchText",
                            ViewBag.SearchText as string,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Invoice number or customer name"
                            }
                        )

                    </div>


                    <!-- From Date -->
                    <div class="col-md-2">

                        <label class="form-label fw-bold">
                            From Date
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")"
                               class="form-control" />

                    </div>


                    <!-- To Date -->
                    <div class="col-md-2">

                        <label class="form-label fw-bold">
                            To Date
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")"
                               class="form-control" />

                    </div>


                    <!-- Search Button -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            Search

                        </button>

                    </div>


                    <!-- Reset -->
                    <div class="col-md-1">

                        @Html.ActionLink(
                            "Reset",
                            "Index",
                            "SalesInvoice",
                            null,
                            new
                            {
                                @class = "btn btn-secondary w-100"
                            }
                        )

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- Invoice Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Invoice Number</th>

                            <th>Date</th>

                            <th>Customer</th>

                            <th>Grand Total</th>

                            <th>Status</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var invoice in Model)
                            {
                                <tr>

                                    <td>
                                        @count
                                    </td>


                                    <td>

                                        <strong>
                                            @invoice.InvoiceNumber
                                        </strong>

                                    </td>


                                    <td>

                                        @(invoice.InvoiceDate.ToString("dd-MM-yyyy"))

                                    </td>


                                    <td>

                                        @(invoice.Customer != null
                                            ? invoice.Customer.CustomerName
                                            : "")

                                    </td>


                                    <td>

                                        ₹@(invoice.GrandTotal.ToString("N2"))

                                    </td>


                                    <td>

                                        @if (invoice.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>


                                    <td class="text-center">

                                        @Html.ActionLink(
                                            "View",
                                            "Details",
                                            new { id = invoice.InvoiceId },
                                            new
                                            {
                                                @class = "btn btn-sm btn-info me-1"
                                            }
                                        )


                                        @Html.ActionLink(
                                            "Print",
                                            "Print",
                                            new { id = invoice.InvoiceId },
                                            new
                                            {
                                                @class = "btn btn-sm btn-secondary me-1"
                                            }
                                        )


                                        @if (invoice.Status != "Cancelled")
                                        {
                                            using (Html.BeginForm(
                                                "Cancel",
                                                "SalesInvoice",
                                                new { id = invoice.InvoiceId },
                                                FormMethod.Post,
                                                new { @class = "d-inline" }
                                            ))
                                            {
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Are you sure you want to cancel this invoice?');">

                                                    Cancel

                                                </button>
                                            }
                                        }

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-4">

                                    <h5 class="text-muted">
                                        No Invoices Found
                                    </h5>

                                    <p class="text-muted mb-0">
                                        No sales invoices are available.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>