@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Sales_Invoice>
@using System.Linq
@using System.Globalization

@{
    ViewBag.Title = "Sales Invoices";
}

<!-- Select2 styles (needed by the lazy dropdowns inside the Create modal) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<!-- DataTables (Bootstrap 5 skin) + Buttons + Responsive -->
<link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* ---------- Invoice DataTable polish ---------- */
    #invoicesTable thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
        vertical-align: middle;
    }

    #invoicesTable tbody td {
        vertical-align: middle;
        padding-top: .65rem;
        padding-bottom: .65rem;
    }

    #invoicesTable tfoot th {
        background: #f8f9fa;
        border-top: 2px solid #198754;
        font-size: .9rem;
    }

    .invoice-table-card div.dataTables_wrapper div.dataTables_length select {
        border-radius: .375rem;
    }

    .invoice-table-card .dt-buttons .btn {
        margin-right: .35rem;
    }

    .invoice-table-card div.dataTables_wrapper div.dataTables_info {
        color: #6c757d;
        font-size: .875rem;
        padding-top: .5rem;
    }

    .invoice-table-card .page-item.active .page-link {
        background-color: #198754;
        border-color: #198754;
    }

    .invoice-table-card .page-link {
        color: #198754;
    }

    .invoice-table-card .page-item.disabled .page-link {
        color: #6c757d;
    }

    table.dataTable > thead > tr > th.sorting:before,
    table.dataTable > thead > tr > th.sorting:after {
        opacity: .35;
    }
</style>

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Sales Invoice Record</h2>
            <p class="text-muted mb-0">Manage, search and view all sales invoices.</p>
        </div>
        <div>
            <button type="button" class="btn btn-success btn-modal"
                    data-size="modal-xl"
                    data-url="@Url.Action("Create", "SalesInvoice")">
                <i class="bi bi-plus-circle me-1"></i> Add Invoice
            </button>
        </div>
    </div>

    <!-- Alert Placeholder -->
    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Search & Filters (server-side: narrows the data set loaded into the table) -->
    <div class="card shadow-sm mb-4 ">
        <div class="card-body">
            @using (Html.BeginForm("Index", "SalesInvoice", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label"><strong>Search</strong></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            @Html.TextBox("searchText", ViewBag.SearchText as string,
                                     new { @class = "form-control", placeholder = "Enter invoice no., customer, date or status", autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><strong>From Date</strong></label>
                        <input type="date" name="fromDate" class="form-control"
                               value="@(ViewBag.FromDate == null ? "" : ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><strong>To Date</strong></label>
                        <input type="date" name="toDate" class="form-control"
                               value="@(ViewBag.ToDate == null ? "" : ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill" title="Search">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                        <a href="@Url.Action("Index", "SalesInvoice")"
                           class="btn btn-outline-secondary" title="Reset filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Reloaded via AJAX after Create / Cancel -->
    <div id="invoiceListContainer">

        @if (Model != null && Model.Items != null && Model.TotalRecords > Model.Items.Count())
        {
            <div class="alert alert-warning py-2 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Showing the first <strong>@Model.Items.Count()</strong> of <strong>@Model.TotalRecords</strong> invoices.
                Use the search or date filters above to narrow the list.
            </div>
        }

        <div class="card shadow-sm invoice-table-card">
            <div class="card-body">

                <table id="invoicesTable" class="table table-hover align-middle table-bordered w-100">
                    <thead class="table-success">
                        <tr>
                            <th class="text-center" style="width:60px;">Sr. No.</th>
                            <th>Invoice Number</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-center">Status</th>
                            <th class="text-center" style="width:140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items != null)
                        {
                            foreach (var invoice in Model.Items)
                            {
                                <tr data-status="@invoice.Status"
                                    data-total="@(invoice.GrandTotal.ToString("0.00", CultureInfo.InvariantCulture))">
                                    <td class="text-center"></td> @* numbered by DataTables on every draw *@
                                    <td><strong>@invoice.InvoiceNumber</strong></td>
                                    <td data-order="@(invoice.InvoiceDate.ToString("yyyyMMdd"))">@invoice.InvoiceDate.ToString("dd-MM-yyyy")</td>
                                    <td>@(invoice.Customer != null ? invoice.Customer.CustomerName : "")</td>
                                    <td class="text-end"
                                        data-order="@(invoice.GrandTotal.ToString("0.00", CultureInfo.InvariantCulture))"
                                        data-export="@(invoice.GrandTotal.ToString("0.00", CultureInfo.InvariantCulture))">
                                        ₹ @invoice.GrandTotal.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (invoice.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                    </td>
                                    <td class="text-center text-nowrap">

                                        <button type="button"
                                                class="btn btn-sm btn-info me-1 btn-modal"
                                                title="View details"
                                                data-size="modal-xl"
                                                data-url="@Url.Action("Details", "SalesInvoice", new { id = invoice.InvoiceId })">
                                            <i class="bi bi-info"></i>
                                        </button>

                                        <a href="@Url.Action("Print", "SalesInvoice", new { id = invoice.InvoiceId })"
                                           class="btn btn-sm btn-secondary me-1"
                                           title="Print invoice"
                                           target="_blank">
                                            <i class="bi bi-printer"></i>
                                        </a>

                                        @if (invoice.Status != "Cancelled")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-danger btn-modal"
                                                    title="Cancel invoice"
                                                    data-size="modal-md"
                                                    data-url="@Url.Action("ConfirmCancel", "SalesInvoice", new { id = invoice.InvoiceId })">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th class="text-end">Total (Active invoices)</th>
                            <th class="text-end"></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>

            </div>
        </div>

    </div> <!-- /invoiceListContainer -->

</div>

<!-- Shared Modal (Create / View / Cancel load here) -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <!-- Select2 (must load before the modal content is injected) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- DataTables core + Bootstrap 5 + Buttons (Excel/CSV/Print/Column visibility) + Responsive -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        $(function () {

            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog');
            var $content = $('#appModalContent');

            // ---------- DataTable ----------
            // Buttons use plain Bootstrap classes instead of the default grey style
            $.fn.dataTable.Buttons.defaults.dom.button.className = 'btn btn-sm';

            function initInvoiceTable() {
                var $table = $('#invoicesTable');
                if (!$table.length) return;

                var exportOpts = { columns: [1, 2, 3, 4, 5], orthogonal: 'export' };

                var dt = $table.DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    order: [[2, 'desc'], [1, 'desc']],
                    autoWidth: false,
                    // No built-in filter box: the Search field above drives the table live
                    dom: "<'row align-items-center mb-3'<'col-md-8'B><'col-md-4 text-md-end'l>>" +
                        "<'row'<'col-12'tr>>" +
                        "<'row align-items-center mt-3'<'col-md-6'i><'col-md-6'p>>",
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel me-1"></i>Excel',
                            className: 'btn-outline-success',
                            title: 'Sales Invoices',
                            exportOptions: exportOpts
                        },
                        {
                            extend: 'print',
                            text: '<i class="bi bi-printer me-1"></i>Print',
                            className: 'btn-outline-secondary',
                            title: 'Sales Invoices',
                            exportOptions: exportOpts
                        },
                        {
                            extend: 'colvis',
                            text: '<i class="bi bi-columns-gap me-1"></i>Columns',
                            className: 'btn-outline-primary',
                            columns: [1, 2, 3, 4, 5]
                        }
                    ],
                    columnDefs: [
                        { targets: [0, 6], orderable: false, searchable: false },
                        { targets: 0, className: 'text-center' },
                        { targets: 4, className: 'text-end' },
                        { targets: [5, 6], className: 'text-center' },
                        { targets: 1, responsivePriority: 1 },
                        { targets: 6, responsivePriority: 2 },
                        { targets: 3, responsivePriority: 3 }
                    ],
                    language: {
                        lengthMenu: 'Show _MENU_ entries',
                        info: 'Showing _START_ to _END_ of _TOTAL_ invoices',
                        infoEmpty: 'No invoices to show',
                        infoFiltered: '(filtered from _MAX_)',
                        emptyTable: '<div class="text-muted py-4"><h5 class="mb-1">No Invoices Found</h5><p class="mb-0">No sales invoices are available.</p></div>',
                        zeroRecords: '<div class="text-muted py-4"><h5 class="mb-1">No Matching Invoices</h5><p class="mb-0">Try a different search term.</p></div>',
                        paginate: { previous: '&laquo;', next: '&raquo;' }
                    },
                    // Keep Sr. No. continuous across pages and correct after sorting / filtering
                    drawCallback: function () {
                        var api = this.api();
                        var start = api.page.info().start;
                        api.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                            cell.innerHTML = start + i + 1;
                        });
                    },
                    // Footer total = Active invoices matching the current filter (cancelled are excluded)
                    footerCallback: function () {
                        var api = this.api(), total = 0;
                        api.rows({ search: 'applied' }).nodes().each(function (tr) {
                            if (tr.getAttribute('data-status') === 'Active') {
                                total += parseFloat(tr.getAttribute('data-total')) || 0;
                            }
                        });
                        $(api.column(4).footer()).html('₹ ' + total.toLocaleString('en-IN', {
                            minimumFractionDigits: 2, maximumFractionDigits: 2
                        }));
                    }
                });

                // Re-apply whatever is already typed in the Search box (page load / after reload)
                var q = $('#searchText').val();
                if (q) dt.search(q).draw();
            }

            // Live filtering while typing (Enter / Search button still does a full server search)
            //$(document).on('input', '#searchText', function () {
            //    if ($.fn.DataTable.isDataTable('#invoicesTable')) {
            //        $('#invoicesTable').DataTable().search(this.value).draw();
            //    }
            //});

            function reloadInvoiceList() {
                if ($.fn.DataTable.isDataTable('#invoicesTable')) {
                    $('#invoicesTable').DataTable().destroy();
                }
                $('#invoiceListContainer')
                    .load(window.location.href + ' #invoiceListContainer > *', initInvoiceTable);
            }

            initInvoiceTable();

            // ---------- Modal / form helpers ----------
            function parseForm() {
                var $form = $content.find('form');
                if ($form.length) {
                    $form.removeData('validator').removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse($form);
                }
            }

            function showAlert(message, type) {
                if (!message) return;

                $('#alertPlaceholder').html(
                    '<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show" role="alert">' +
                    $('<div>').text(message).html() +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '</div>');
            }

            // Open modal: load Create / Details / ConfirmCancel
            // (delegated, so it also works for rows redrawn by DataTables and responsive child rows)
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url');
                var size = $(this).data('size') || 'modal-lg';

                $.get(url)
                    .done(function (html) {
                        $dialog.removeClass('modal-sm modal-md modal-lg modal-xl').addClass(size);
                        $content.html(html);   // inline scripts in the partial run here
                        parseForm();
                        modal.show();
                    })
                    .fail(function () {
                        alert('Unable to load the form. Please try again.');
                    });
            });

            // Submit any form inside the modal via AJAX
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();

                var $form = $(this);
                if (!$form.valid()) return;

                var $btn = $form.find('[type=submit]').prop('disabled', true);

                $.post($form.attr('action'), $form.serialize())
                    .done(function (res) {
                        if (typeof res === 'object') {
                            modal.hide();
                            showAlert(res.message, res.success ? 'success' : 'danger');

                            if (res.success) {
                                reloadInvoiceList();
                            }
                        }
                        else {
                            $content.html(res);
                            parseForm();
                        }
                    })
                    .fail(function () {
                        alert('Something went wrong. Please try again.');
                    })
                    .always(function () {
                        $btn.prop('disabled', false);
                    });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                $content.empty();
            });
        });
    </script>
}
