@{
    ViewBag.Title = "Sales Invoices";
}

<!-- Select2 styles (needed by the lazy dropdowns inside the Create modal) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    #invoicesTable thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
        vertical-align: middle;
    }

    #invoicesTable tbody td {
        vertical-align: middle;
        padding-top: .65rem;
        padding-bottom: .65rem;
    }

    #invoicesTable tbody tr {
        animation: rowIn .25s ease-out;
    }

    @@keyframes rowIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Sales Invoice Record</h2>
            <p class="text-muted mb-0">Manage, search and view all sales invoices.</p>
        </div>
        <button type="button" class="btn btn-success btn-modal" data-size="modal-xl"
                data-url="@Url.Action("Create", "SalesInvoice")">
            <i class="bi bi-plus-circle me-1"></i> Add Invoice
        </button>
    </div>

    <!-- Alert Placeholder -->
    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
    </div>

    <!-- Filters: typing or changing a date restarts the list from the top (no page reload) -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="filterForm" autocomplete="off">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label"><strong>Search</strong></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" id="searchText" class="form-control" placeholder="Invoice number or customer name" value="@(ViewBag.SearchText as string)" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><strong>From Date</strong></label>
                        <input type="date" id="fromDate" class="form-control" value="@(ViewBag.FromDate == null ? "" : ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><strong>To Date</strong></label>
                        <input type="date" id="toDate" class="form-control" value="@(ViewBag.ToDate == null ? "" : ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i> Search</button>
                        <button type="button" id="resetBtn" class="btn btn-outline-secondary" title="Reset filters"><i class="bi bi-arrow-counterclockwise"></i></button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Invoice feed -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div id="countInfo" class="text-muted small mb-2"></div>

            <div class="table-responsive">
                <table id="invoicesTable" class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-success">
                        <tr>
                            <th class="text-center" style="width:60px;">Sr. No.</th>
                            <th>Invoice Number</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-center">Status</th>
                            <th class="text-center" style="width:140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="invoiceBody"></tbody>
                </table>
            </div>

            <div id="emptyState" class="text-center text-muted py-5 d-none">
                <i class="bi bi-inbox fs-2"></i>
                <h5 class="mt-2 mb-1">No Invoices Found</h5>
                <p class="mb-0">Try a different search or date range.</p>
            </div>

            <!-- Scroll sentinel: when it comes into view the next batch loads -->
            <div id="scrollSentinel" class="text-center text-muted small py-3">
                <span id="spinner" class="d-none"><span class="spinner-border spinner-border-sm text-success me-2"></span>Loading more invoices...</span>
                <span id="endMsg" class="d-none"><i class="bi bi-check2-circle me-1"></i>You're all caught up</span>
            </div>
        </div>
    </div>
</div>

<!-- Shared Modal (Create / View / Cancel load here) -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal'), modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog'), $content = $('#appModalContent');
            var $body = $('#invoiceBody'), $spin = $('#spinner'), $end = $('#endMsg'), $empty = $('#emptyState'), $info = $('#countInfo');
            var sentinel = document.getElementById('scrollSentinel');
            var PAGE_SIZE = 20, listUrl = '@Url.Action("LoadInvoices", "SalesInvoice")';

            // ---------- Cursor-based infinite scroll ----------
            var cursor = {}, loading = false, hasMore = true, seq = 0, count = 0, total = 0;

            var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); };

            function rowHtml(i, n) {
                var active = i.status === 'Active';
                return '<tr><td class="text-center">' + n + '</td><td><strong>' + esc(i.invoiceNumber) + '</strong></td><td>' + esc(i.date) + '</td><td>' + esc(i.customer) + '</td>' +
                    '<td class="text-end">₹ ' + esc(i.total) + '</td><td class="text-center"><span class="badge bg-' + (active ? 'success' : 'danger') + '">' + (active ? 'Active' : 'Cancelled') + '</span></td>' +
                    '<td class="text-center text-nowrap">' +
                    '<button type="button" class="btn btn-sm btn-info me-1 btn-modal" title="View details" data-size="modal-xl" data-url="' + esc(i.detailsUrl) + '"><i class="bi bi-info"></i></button>' +
                    '<a href="' + esc(i.printUrl) + '" target="_blank" class="btn btn-sm btn-secondary me-1" title="Print invoice"><i class="bi bi-printer"></i></a>' +
                    (i.status === 'Cancelled' ? '' : '<button type="button" class="btn btn-sm btn-danger btn-modal" title="Cancel invoice" data-size="modal-md" data-url="' + esc(i.cancelUrl) + '"><i class="bi bi-x-circle"></i></button>') +
                    '</td></tr>';
            }

            // reset = true restarts from the newest invoice (filters changed / invoice created / cancelled)
            function load(reset) {
                if (reset) { seq++; cursor = {}; hasMore = true; count = 0; total = 0; $body.empty(); $end.addClass('d-none'); $empty.addClass('d-none'); $info.text(''); }
                else if (loading || !hasMore) return;

                var mySeq = seq;
                loading = true;
                $spin.removeClass('d-none');

                $.getJSON(listUrl, {
                    searchText: $('#searchText').val(), fromDate: $('#fromDate').val(), toDate: $('#toDate').val(),
                    lastDate: cursor.date || '', lastId: cursor.id || '', pageSize: PAGE_SIZE
                })
                    .done(function (r) {
                        if (mySeq !== seq) return;                       // a newer request replaced this one
                        if (r.total) total = r.total;                    // total is only sent with the first batch
                        $body.append($.map(r.items, function (i) { return rowHtml(i, ++count); }).join(''));
                        if (r.items.length) { var last = r.items[r.items.length - 1]; cursor = { date: last.cursorDate, id: last.id }; }
                        hasMore = r.hasMore;
                        $empty.toggleClass('d-none', count > 0);
                        $end.toggleClass('d-none', hasMore || count === 0);
                        $info.text(count ? 'Showing ' + count + ' of ' + total + ' invoices' : '');
                        // short list that doesn't fill the screen yet: keep loading
                        setTimeout(function () { if (hasMore && sentinel.getBoundingClientRect().top < window.innerHeight + 300) load(false); }, 0);
                    })
                    .fail(function () { if (mySeq === seq) showAlert('Unable to load invoices. Please try again.', 'danger'); })
                    .always(function () { if (mySeq === seq) { loading = false; $spin.addClass('d-none'); } });
            }

            new IntersectionObserver(function (e) { if (e[0].isIntersecting) load(false); }, { rootMargin: '300px' }).observe(sentinel);
            load(true);

            // Filters
            var typing;
            $('#searchText').on('input', function () { clearTimeout(typing); typing = setTimeout(function () { load(true); }, 350); });
            $('#fromDate, #toDate').on('change', function () { load(true); });
            $('#filterForm').on('submit', function (e) { e.preventDefault(); load(true); });
            $('#resetBtn').on('click', function () { $('#filterForm')[0].reset(); $('#searchText, #fromDate, #toDate').val(''); load(true); });

            // Coming back to the tab after a while: show the latest invoices
            var hiddenAt = 0;
            document.addEventListener('visibilitychange', function () {
                if (document.hidden) hiddenAt = Date.now();
                else if (hiddenAt && Date.now() - hiddenAt > 60000 && !modalEl.classList.contains('show')) load(true);
            });

            // ---------- Modal / form helpers ----------
            function parseForm() {
                var $form = $content.find('form');
                if ($form.length) { $form.removeData('validator').removeData('unobtrusiveValidation'); $.validator.unobtrusive.parse($form); }
            }

            function showAlert(message, type) {
                if (!message) return;
                $('#alertPlaceholder').html('<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show" role="alert">' + esc(message) +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            // Open modal: load Create / Details / ConfirmCancel (delegated: works for rows added by scrolling)
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url'), size = $(this).data('size') || 'modal-lg';
                $.get(url)
                    .done(function (html) {
                        $dialog.removeClass('modal-sm modal-md modal-lg modal-xl').addClass(size);
                        $content.html(html);   // inline scripts in the partial run here
                        parseForm();
                        modal.show();
                    })
                    .fail(function () { alert('Unable to load the form. Please try again.'); });
            });

            // Submit any form inside the modal via AJAX
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();
                var $form = $(this);
                if (!$form.valid()) return;
                var $btn = $form.find('[type=submit]').prop('disabled', true);

                $.post($form.attr('action'), $form.serialize())
                    .done(function (res) {
                        if (typeof res === 'object') {
                            modal.hide();
                            showAlert(res.message, res.success ? 'success' : 'danger');
                            if (res.success) load(true);
                        } else { $content.html(res); parseForm(); }
                    })
                    .fail(function () { alert('Something went wrong. Please try again.'); })
                    .always(function () { $btn.prop('disabled', false); });
            });

            modalEl.addEventListener('hidden.bs.modal', function () { $content.empty(); });
        });
    </script>
}
