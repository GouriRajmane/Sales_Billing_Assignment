@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Sales_Invoice>

@{
    ViewBag.Title = "Sales Invoices";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Sales Invoice Record
            </h2>

            <p class="text-muted mb-0">
                Manage, search and view all sales invoices.
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "+ Create Invoice",
                "Create",
                "SalesInvoice",
                null,
                new { @class = "btn btn-primary" }
            )
        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search and Filters -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            @using (Html.BeginForm(
                "Index",
                "SalesInvoice",
                FormMethod.Get))
            {
                <div class="row g-3 align-items-end">

                    <!-- Search -->
                    <div class="col-md-5">

                        <label class="form-label fw-bold">
                            Search
                        </label>

                        @Html.TextBox(
                            "searchText",
                            ViewBag.SearchText as string,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Invoice number or customer name"
                            }
                        )

                    </div>


                    <!-- From Date -->
                    <div class="col-md-2">

                        <label class="form-label fw-bold">
                            From Date
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@(ViewBag.FromDate != null
                                   ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd")
                                   : "")"
                               class="form-control" />

                    </div>


                    <!-- To Date -->
                    <div class="col-md-2">

                        <label class="form-label fw-bold">
                            To Date
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@(ViewBag.ToDate != null
                                   ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd")
                                   : "")"
                               class="form-control" />

                    </div>


                    <!-- Search Button -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            Search

                        </button>

                    </div>


                    <!-- Reset -->
                    <div class="col-md-1">

                        @Html.ActionLink(
                            "Reset",
                            "Index",
                            "SalesInvoice",
                            null,
                            new
                            {
                                @class = "btn btn-secondary w-100"
                            }
                        )

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- Invoice Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>Sr. No.</th>

                            <th>Invoice Number</th>

                            <th>Date</th>

                            <th>Customer</th>

                            <th>Grand Total</th>

                            <th>Status</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null &&
                            Model.Items != null &&
                            Model.Items.Any())
                        {
                            int count =
                                ((Model.CurrentPage - 1) * Model.PageSize) + 1;

                            foreach (var invoice in Model.Items)
                            {
                                <tr>

                                    <!-- Sr. No. -->
                                    <td>
                                        @count
                                    </td>


                                    <!-- Invoice Number -->
                                    <td>
                                        <strong>
                                            @invoice.InvoiceNumber
                                        </strong>
                                    </td>


                                    <!-- Date -->
                                    <td>
                                        @invoice.InvoiceDate.ToString("dd-MM-yyyy")
                                    </td>


                                    <!-- Customer -->
                                    <td>
                                        @(invoice.Customer != null
                                            ? invoice.Customer.CustomerName
                                            : "")
                                    </td>


                                    <!-- Grand Total -->
                                    <td>
                                        ₹ @invoice.GrandTotal.ToString("N2")
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (invoice.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        @Html.ActionLink(
                                            "View",
                                            "Details",
                                            new { id = invoice.InvoiceId },
                                            new
                                            {
                                                @class = "btn btn-sm btn-info me-1"
                                            }
                                        )

                                        @Html.ActionLink(
                                            "Print",
                                            "Print",
                                            new { id = invoice.InvoiceId },
                                            new
                                            {
                                                @class = "btn btn-sm btn-secondary me-1"
                                            }
                                        )

                                        @if (invoice.Status != "Cancelled")
                                        {
                                            using (Html.BeginForm(
                                                "Cancel",
                                                "SalesInvoice",
                                                new { id = invoice.InvoiceId },
                                                FormMethod.Post,
                                                new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Are you sure you want to cancel this invoice?');">

                                                    Cancel

                                                </button>
                                            }
                                        }

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-4">

                                    <div class="text-muted">

                                        <h5>
                                            No Invoices Found
                                        </h5>

                                        <p class="mb-0">
                                            No sales invoices are available.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- Pagination -->
    @if (Model != null && Model.TotalPages > 0)
    {
        <div class="row mt-4">

            <!-- Record Information -->
            <div class="col-md-6">

                <p class="text-muted">

                    Showing

                    <strong>
                        @(((Model.CurrentPage - 1) * Model.PageSize) + 1)
                    </strong>

                    -

                    <strong>
                        @(Math.Min(
                            Model.CurrentPage * Model.PageSize,
                            Model.TotalRecords))
                    </strong>

                    of

                    <strong>
                        @Model.TotalRecords
                    </strong>

                    invoices

                </p>

            </div>


            <!-- Pagination -->
            <div class="col-md-6 text-end">

                <ul class="pagination justify-content-end">

                    <!-- Previous -->
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               href="@Url.Action(
                                   "Index",
                                   "SalesInvoice",
                                   new
                                   {
                                       page = Model.CurrentPage - 1,
                                       pageSize = Model.PageSize,
                                       searchText = ViewBag.SearchText,
                                       fromDate = ViewBag.FromDate,
                                       toDate = ViewBag.ToDate
                                   })">

                                &laquo; Previous

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                &laquo; Previous
                            </span>

                        </li>
                    }


                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <li class="page-item active">

                                <span class="page-link">
                                    @i
                                </span>

                            </li>
                        }
                        else
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   href="@Url.Action(
                                       "Index",
                                       "SalesInvoice",
                                       new
                                       {
                                           page = i,
                                           pageSize = Model.PageSize,
                                           searchText = ViewBag.SearchText,
                                           fromDate = ViewBag.FromDate,
                                           toDate = ViewBag.ToDate
                                       })">

                                    @i

                                </a>

                            </li>
                        }
                    }


                    <!-- Next -->
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               href="@Url.Action(
                                   "Index",
                                   "SalesInvoice",
                                   new
                                   {
                                       page = Model.CurrentPage + 1,
                                       pageSize = Model.PageSize,
                                       searchText = ViewBag.SearchText,
                                       fromDate = ViewBag.FromDate,
                                       toDate = ViewBag.ToDate
                                   })">

                                Next &raquo;

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                Next &raquo;
                            </span>

                        </li>
                    }

                </ul>

            </div>

        </div>
    }

</div>