@model Sales_Billing_System.Models.Sales_Invoice

@{
    bool cancelled = Model.Status == "Cancelled";
    string customerName = Model.Customer != null ? Model.Customer.CustomerName : "";
    int itemCount = Model.InvoiceItems != null ? Model.InvoiceItems.Count : 0;
}

<div class="modal-header bg-info text-white">
    <div>
        <h5 class="modal-title mb-0">Invoice Details</h5>
        <small class="text-white">View complete invoice information.</small>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">

    @if (cancelled)
    {
        <div class="alert alert-danger">
            <i class="bi bi-x-octagon me-1"></i><strong>This invoice has been cancelled.</strong>
        </div>
    }

    <!-- Invoice number and status -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h4 class="mb-1">@Model.InvoiceNumber</h4>
            <div class="text-muted"><i class="bi bi-person me-1"></i>@customerName</div>
        </div>

        @if (cancelled)
        {
            <span class="badge bg-danger fs-6">Cancelled</span>
        }
        else
        {
            <span class="badge bg-success fs-6">@Model.Status</span>
        }
    </div>

    <!-- Key figures -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="bg-light border rounded p-3 text-center h-100">
                <div class="small text-muted">Invoice Date</div>
                <div class="fs-5 fw-bold">@Model.InvoiceDate.ToString("dd-MM-yyyy")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-light border rounded p-3 text-center h-100">
                <div class="small text-muted">Items</div>
                <div class="fs-5 fw-bold">@itemCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-light border rounded p-3 text-center h-100">
                <div class="small text-muted">Grand Total</div>
                <div class="fs-4 fw-bold text-success">₹ @Model.GrandTotal.ToString("N2")</div>
            </div>
        </div>
    </div>

    <!-- Invoice Items -->
    <h6 class="text-uppercase small text-muted fw-bold mb-2">Invoice Items</h6>

    <div class="table-responsive mb-4">
        <table class="table table-bordered table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:60px;">Sr.No.</th>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Rate</th>
                    <th class="text-end">GST %</th>
                    <th class="text-end">Taxable Amount</th>
                    <th class="text-end">GST Amount</th>
                    <th class="text-end">Total Amount</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int count = 1;
                }

                @foreach (var item in Model.InvoiceItems)
                {
                    <tr>
                        <td class="text-center">@count</td>
                        <td>@(item.Product != null ? item.Product.ProductName : "")</td>
                        <td class="text-end">@(item.Quantity.ToString("N2"))</td>
                        <td class="text-end">₹ @(item.Rate.ToString("N2"))</td>
                        <td class="text-end">@(item.GSTPercentage.ToString("N2")) %</td>
                        <td class="text-end">₹ @(item.TaxableAmount.ToString("N2"))</td>
                        <td class="text-end">₹ @(item.GSTAmount.ToString("N2"))</td>
                        <td class="text-end"><strong>₹ @(item.TotalAmount.ToString("N2"))</strong></td>
                    </tr>

                    count++;
                }
            </tbody>
        </table>
    </div>

    <!-- Totals -->
    <div class="row justify-content-end">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Invoice Summary</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Total Taxable Amount</span>
                        <strong>₹ @(Model.TotalTaxableAmount.ToString("N2"))</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Total GST Amount</span>
                        <strong>₹ @(Model.TotalGSTAmount.ToString("N2"))</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Grand Total</h5>
                        <h5 class="mb-0 text-success">₹ @(Model.GrandTotal.ToString("N2"))</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="modal-footer">

    @if (!cancelled)
    {
        <button type="button"
                class="btn btn-danger btn-modal"
                data-size="modal-md"
                data-url="@Url.Action("ConfirmCancel", "SalesInvoice", new { id = Model.InvoiceId })">
            <i class="bi bi-x-circle me-1"></i>
            Cancel Invoice
        </button>
    }

    @Html.ActionLink("Print Invoice", "Print", "SalesInvoice",
            new { id = Model.InvoiceId },
            new { @class = "btn btn-primary", target = "_blank" })

    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

</div>
