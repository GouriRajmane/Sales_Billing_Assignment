@model Sales_Billing_System.Models.Sales_Invoice

<div class="modal-header bg-info text-white">
    <div>
        <h5 class="modal-title mb-0">Invoice Details</h5>
        <small class="text-white">View complete invoice information.</small>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    @if (Model.Status == "Cancelled")
    {
        <div class="alert alert-danger">
            <strong>This invoice has been cancelled.</strong>
        </div>
    }

    <!-- Invoice Information -->
    <div class="row">

        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Invoice Number</label>
            <div class="form-control bg-light">@Model.InvoiceNumber</div>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Invoice Date</label>
            <div class="form-control bg-light">@(Model.InvoiceDate.ToString("dd-MM-yyyy"))</div>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Status</label>
            <div class="form-control bg-light">@Model.Status</div>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Customer</label>
            <div class="form-control bg-light">
                @(Model.Customer != null ? Model.Customer.CustomerName : "")
            </div>
        </div>

    </div>

    <!-- Invoice Items -->
    <h6 class="fw-bold mt-2">Invoice Items</h6>

    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sr.No.</th>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Rate</th>
                    <th>GST %</th>
                    <th>Taxable Amount</th>
                    <th>GST Amount</th>
                    <th>Total Amount</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int count = 1;
                }

                @foreach (var item in Model.InvoiceItems)
                {
                    <tr>
                        <td>@count</td>
                        <td>@(item.Product != null ? item.Product.ProductName : "")</td>
                        <td>@(item.Quantity.ToString("N2"))</td>
                        <td>₹@(item.Rate.ToString("N2"))</td>
                        <td>@(item.GSTPercentage.ToString("N2"))%</td>
                        <td>₹@(item.TaxableAmount.ToString("N2"))</td>
                        <td>₹@(item.GSTAmount.ToString("N2"))</td>
                        <td><strong>₹@(item.TotalAmount.ToString("N2"))</strong></td>
                    </tr>

                    count++;
                }
            </tbody>
        </table>
    </div>

    <!-- Totals -->
    <div class="row justify-content-end">
        <div class="col-md-5">
            <div class="card shadow-sm">

                <div class="card-header bg-light">
                    <h6 class="mb-0">Invoice Summary</h6>
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">
                        <span>Total Taxable Amount</span>
                        <strong>₹@(Model.TotalTaxableAmount.ToString("N2"))</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Total GST Amount</span>
                        <strong>₹@(Model.TotalGSTAmount.ToString("N2"))</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <h5 class="mb-0">Grand Total</h5>
                        <h5 class="mb-0">₹@(Model.GrandTotal.ToString("N2"))</h5>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<div class="modal-footer">

    @if (Model.Status != "Cancelled")
    {
        <button type="button"
                class="btn btn-danger btn-modal"
                data-size="modal-md"
                data-url="@Url.Action("ConfirmCancel", "SalesInvoice", new { id = Model.InvoiceId })">
            Cancel Invoice
        </button>
    }

    @Html.ActionLink("Print Invoice", "Print", "SalesInvoice",
        new { id = Model.InvoiceId },
        new { @class = "btn btn-secondary", target = "_blank" })

    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>

</div>