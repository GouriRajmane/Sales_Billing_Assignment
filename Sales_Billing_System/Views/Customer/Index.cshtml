@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Customer_Master>
@using System.Linq

@{
    ViewBag.Title = "Customers";
}

<!-- DataTables (Bootstrap 5 skin) + Buttons + Responsive -->
<link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* ---------- DataTable polish (same as Sales Invoice) ---------- */
    #customersTable thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
        vertical-align: middle;
    }

    #customersTable tbody td {
        vertical-align: middle;
        padding-top: .65rem;
        padding-bottom: .65rem;
    }

    .data-table-card div.dataTables_wrapper div.dataTables_length select {
        border-radius: .375rem;
    }

    .data-table-card .dt-buttons .btn {
        margin-right: .35rem;
    }

    .data-table-card div.dataTables_wrapper div.dataTables_info {
        color: #6c757d;
        font-size: .875rem;
        padding-top: .5rem;
    }

    .data-table-card .page-item.active .page-link {
        background-color: #198754;
        border-color: #198754;
        color: #ffffff; /* Adds white text color when active */
    }
    .data-table-card .page-link {
        color: #198754;
    }

    .data-table-card .page-item.disabled .page-link {
        color: #6c757d;
    }

    table.dataTable > thead > tr > th.sorting:before,
    table.dataTable > thead > tr > th.sorting:after {
        opacity: .35;
    }
</style>

<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Customer Master</h2>
            <p class="text-muted mb-0">Manage your customers and their information.</p>
        </div>
        <div>
            <button type="button" class="btn btn-success btn-modal"
                    data-url="@Url.Action("Create", "Customer")">
                <i class="bi bi-plus-circle me-1"></i> Add Customer
            </button>
        </div>
        <a href="@Url.Action("Compare", "Customer")" class="btn btn-outline-secondary me-2">
            <i class="bi bi-diagram-3 me-1"></i> Compare pagination
        </a>
    </div>

    <!-- Alert Placeholder (used by AJAX messages) -->
    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Search: filters the table live while typing; Enter / Search runs a server search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Customer", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label"><strong>Search</strong></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            @Html.TextBox("searchText", ViewBag.SearchText as string,
                                     new { @class = "form-control", placeholder = "Enter customer name, mobile number, GSTIN or address", autocomplete = "off" })
                        </div>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill" title="Search">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                        <a href="@Url.Action("Index", "Customer")"
                           class="btn btn-outline-secondary" title="Reset filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Reloaded via AJAX after Create / Edit -->
    <div id="customerListContainer">

        @if (Model != null && Model.Items != null && Model.TotalRecords > Model.Items.Count())
        {
            <div class="alert alert-warning py-2 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Showing the first <strong>@Model.Items.Count()</strong> of <strong>@Model.TotalRecords</strong> customers.
                Use the search above to narrow the list.
            </div>
        }

        <div class="card shadow-sm data-table-card">
            <div class="card-body">

                <table id="customersTable" class="table table-hover align-middle table-bordered w-100">
                    <thead class="table-success">
                        <tr>
                            <th class="text-center" style="width:60px;">Sr. No.</th>
                            <th>Customer Name</th>
                            <th>GSTIN</th>
                            <th>Mobile Number</th>
                            <th>Address</th>
                            <th class="text-center" style="width:110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items != null)
                        {
                            foreach (var customer in Model.Items)
                            {
                                <tr>
                                    <td class="text-center"></td> @* numbered by DataTables on every draw *@
                                    <td><strong>@customer.CustomerName</strong></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(customer.GSTIN))
                                        {
                                            @customer.GSTIN
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Available</span>
                                        }
                                    </td>
                                    <td>@customer.MobileNumber</td>
                                    <td>@customer.Address</td>

                                    <td class="text-center text-nowrap">
                                        <button type="button"
                                                class="btn btn-sm btn-info text-white me-1 btn-modal"
                                                title="View Details"
                                                aria-label="View Details"
                                                data-url="@Url.Action("Details", "Customer", new { id = customer.CustomerId })">
                                            <i class="bi bi-info"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-warning btn-modal"
                                                title="Edit Customer"
                                                aria-label="Edit Customer"
                                                data-url="@Url.Action("Edit", "Customer", new { id = customer.CustomerId })">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>

    </div> <!-- /customerListContainer -->

</div>

<!-- Shared Modal (Create / Edit / Details load here) -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <!-- DataTables core + Bootstrap 5 + Buttons (Excel/CSV/Print/Column visibility) + Responsive -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        $(function () {

            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog');
            var $content = $('#appModalContent');

            // ---------- DataTable ----------
            $.fn.dataTable.Buttons.defaults.dom.button.className = 'btn btn-sm';

            function initCustomerTable() {
                var $table = $('#customersTable');
                if (!$table.length) return;

                var exportOpts = { columns: [1, 2, 3, 4], orthogonal: 'export' };

                var dt = $table.DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    order: [[1, 'asc']],
                    autoWidth: false,
                    // No built-in filter box: the Search field above drives the table live
                    dom: "<'row align-items-center mb-3'<'col-md-8'B><'col-md-4 text-md-end'l>>" +
                        "<'row'<'col-12'tr>>" +
                        "<'row align-items-center mt-3'<'col-md-6'i><'col-md-6'p>>",
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel me-1"></i>Excel',
                            className: 'btn-outline-success',
                            title: 'Customers',
                            exportOptions: exportOpts
                        },
                        {
                            extend: 'print',
                            text: '<i class="bi bi-printer me-1"></i>Print',
                            className: 'btn-outline-secondary',
                            title: 'Customers',
                            exportOptions: exportOpts
                        },
                        {
                            extend: 'colvis',
                            text: '<i class="bi bi-columns-gap me-1"></i>Columns',
                            className: 'btn-outline-primary',
                            columns: [1, 2, 3, 4]
                        }
                    ],
                    columnDefs: [
                        { targets: [0, 5], orderable: false, searchable: false },
                        { targets: [0, 5], className: 'text-center' },
                        { targets: 1, responsivePriority: 1 },
                        { targets: 5, responsivePriority: 2 },
                        { targets: 3, responsivePriority: 3 }
                    ],
                    language: {
                        lengthMenu: 'Show _MENU_ entries',
                        info: 'Showing _START_ to _END_ of _TOTAL_ customers',
                        infoEmpty: 'No customers to show',
                        infoFiltered: '(filtered from _MAX_)',
                        emptyTable: '<div class="text-muted py-4"><h5 class="mb-1">No Customers Found</h5><p class="mb-0">There are currently no customers available.</p></div>',
                        zeroRecords: '<div class="text-muted py-4"><h5 class="mb-1">No Matching Customers</h5><p class="mb-0">Try a different search term.</p></div>',
                        paginate: { previous: '&laquo;', next: '&raquo;' }
                    },
                    // Keep Sr. No. continuous across pages and correct after sorting / filtering
                    drawCallback: function () {
                        var api = this.api();
                        var start = api.page.info().start;
                        api.column(0, { page: 'current' }).nodes().each(function (cell, i) {
                            cell.innerHTML = start + i + 1;
                        });
                    }
                });

                // Re-apply whatever is already typed in the Search box (page load / after reload)
                var q = $('#searchText').val();
                if (q) dt.search(q).draw();
            }

            // Live filtering while typing (Enter / Search button still does a full server search)
            //$(document).on('input', '#searchText', function () {
            //    if ($.fn.DataTable.isDataTable('#customersTable')) {
            //        $('#customersTable').DataTable().search(this.value).draw();
            //    }
            //});

            function reloadCustomerList() {
                if ($.fn.DataTable.isDataTable('#customersTable')) {
                    $('#customersTable').DataTable().destroy();
                }
                // Reload only the list, keeping current search
                $('#customerListContainer')
                    .load(window.location.href + ' #customerListContainer > *', initCustomerTable);
            }

            initCustomerTable();

            // ---------- Modal / form helpers ----------
            function parseForm() {
                var $form = $content.find('form');
                if ($form.length) {
                    $form.removeData('validator').removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse($form);
                }
            }

            function showAlert(message, type) {
                if (!message) return;

                $('#alertPlaceholder').html(
                    '<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show" role="alert">' +
                    $('<div>').text(message).html() +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '</div>');
            }

            // Open modal: load Create / Edit / Details
            // (delegated, so it also works for rows redrawn by DataTables and responsive child rows)
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url');
                var size = $(this).data('size') || 'modal-lg';

                $.get(url)
                    .done(function (html) {
                        $dialog.removeClass('modal-sm modal-md modal-lg modal-xl').addClass(size);
                        $content.html(html);
                        parseForm();
                        modal.show();
                    })
                    .fail(function () {
                        alert('Unable to load the form. Please try again.');
                    });
            });

            // Submit any form inside the modal via AJAX
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();

                var $form = $(this);
                if (!$form.valid()) return;

                var $btn = $form.find('[type=submit]').prop('disabled', true);

                $.post($form.attr('action'), $form.serialize())
                    .done(function (res) {
                        if (typeof res === 'object') {
                            modal.hide();
                            showAlert(res.message, res.success ? 'success' : 'danger');

                            if (res.success) {
                                reloadCustomerList();
                            }
                        }
                        else {
                            // Validation failed: show form again with errors
                            $content.html(res);
                            parseForm();
                        }
                    })
                    .fail(function () {
                        alert('Something went wrong. Please try again.');
                    })
                    .always(function () {
                        $btn.prop('disabled', false);
                    });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                $content.empty();
            });
        });
    </script>
}
