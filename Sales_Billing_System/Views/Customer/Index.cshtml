@{
    ViewBag.Title = "Customers";
}

<style>
    #customersTable thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: nowrap;
        vertical-align: middle;
    }

    #customersTable tbody td {
        vertical-align: middle;
        padding-top: .65rem;
        padding-bottom: .65rem;
    }

    #customersTable tbody tr {
        animation: rowIn .25s ease-out;
    }

    @@keyframes rowIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Customer Master</h2>
            <p class="text-muted mb-0">Manage your customers and their information.</p>
        </div>
        <button type="button" class="btn btn-success btn-modal" data-url="@Url.Action("Create", "Customer")">
            <i class="bi bi-plus-circle me-1"></i> Add Customer
        </button>
    </div>

    <!-- Alert Placeholder (used by AJAX messages) -->
    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
    </div>

    <!-- Search: typing restarts the list from the top (no page reload) -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="filterForm" autocomplete="off">
                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label"><strong>Search</strong></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" id="searchText" class="form-control" placeholder="Enter customer name, mobile number, GSTIN or address" value="@(ViewBag.SearchText as string)" />
                        </div>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i> Search</button>
                        <button type="button" id="resetBtn" class="btn btn-outline-secondary" title="Reset filters"><i class="bi bi-arrow-counterclockwise"></i></button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Customer feed -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div id="countInfo" class="text-muted small mb-2"></div>

            <div class="table-responsive">
                <table id="customersTable" class="table table-hover align-middle table-bordered mb-0">
                    <thead class="table-success">
                        <tr>
                            <th class="text-center" style="width:60px;">Sr. No.</th>
                            <th>Customer Name</th>
                            <th>GSTIN</th>
                            <th>Mobile Number</th>
                            <th>Address</th>
                            <th class="text-center" style="width:110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customerBody"></tbody>
                </table>
            </div>

            <div id="emptyState" class="text-center text-muted py-5 d-none">
                <i class="bi bi-inbox fs-2"></i>
                <h5 class="mt-2 mb-1">No Customers Found</h5>
                <p class="mb-0">Try another search or add a new customer.</p>
            </div>

            <!-- Scroll sentinel: when it comes into view the next batch loads -->
            <div id="scrollSentinel" class="text-center text-muted small py-3">
                <span id="spinner" class="d-none"><span class="spinner-border spinner-border-sm text-success me-2"></span>Loading more customers...</span>
                <span id="endMsg" class="d-none"><i class="bi bi-check2-circle me-1"></i>You're all caught up</span>
            </div>
        </div>
    </div>
</div>

<!-- Shared Modal (Create / Edit / Details load here) -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {
            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal'), modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog'), $content = $('#appModalContent');
            var $body = $('#customerBody'), $spin = $('#spinner'), $end = $('#endMsg'), $empty = $('#emptyState'), $info = $('#countInfo');
            var sentinel = document.getElementById('scrollSentinel');
            var PAGE_SIZE = 20, listUrl = '@Url.Action("LoadCustomers", "Customer")';

            // ---------- Cursor-based infinite scroll (cursor = id of the last customer received) ----------
            var lastId = '', loading = false, hasMore = true, seq = 0, count = 0, total = 0;

            var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); };

            function rowHtml(c, n) {
                return '<tr><td class="text-center">' + n + '</td><td><strong>' + esc(c.name) + '</strong></td>' +
                    '<td>' + (c.gstin ? esc(c.gstin) : '<span class="text-muted">Not Available</span>') + '</td><td>' + esc(c.mobile) + '</td><td>' + esc(c.address) + '</td>' +
                    '<td class="text-center text-nowrap">' +
                    '<button type="button" class="btn btn-sm btn-info text-white me-1 btn-modal" title="View Details" aria-label="View Details" data-url="' + esc(c.detailsUrl) + '"><i class="bi bi-info"></i></button>' +
                    '<button type="button" class="btn btn-sm btn-warning btn-modal" title="Edit Customer" aria-label="Edit Customer" data-url="' + esc(c.editUrl) + '"><i class="bi bi-pencil-square"></i></button>' +
                    '</td></tr>';
            }

            // reset = true restarts from the first customer (search changed / customer saved)
            function load(reset) {
                if (reset) { seq++; lastId = ''; hasMore = true; count = 0; total = 0; $body.empty(); $end.addClass('d-none'); $empty.addClass('d-none'); $info.text(''); }
                else if (loading || !hasMore) return;

                var mySeq = seq;
                loading = true;
                $spin.removeClass('d-none');

                $.getJSON(listUrl, { searchText: $('#searchText').val(), lastId: lastId, pageSize: PAGE_SIZE })
                    .done(function (r) {
                        if (mySeq !== seq) return;                       // a newer request replaced this one
                        if (r.total) total = r.total;                    // total is only sent with the first batch
                        $body.append($.map(r.items, function (c) { return rowHtml(c, ++count); }).join(''));
                        if (r.items.length) lastId = r.items[r.items.length - 1].id;
                        hasMore = r.hasMore;
                        $empty.toggleClass('d-none', count > 0);
                        $end.toggleClass('d-none', hasMore || count === 0);
                        $info.text(count ? 'Showing ' + count + ' of ' + total + ' customers' : '');
                        // short list that doesn't fill the screen yet: keep loading
                        setTimeout(function () { if (hasMore && sentinel.getBoundingClientRect().top < window.innerHeight + 300) load(false); }, 0);
                    })
                    .fail(function () { if (mySeq === seq) showAlert('Unable to load customers. Please try again.', 'danger'); })
                    .always(function () { if (mySeq === seq) { loading = false; $spin.addClass('d-none'); } });
            }

            new IntersectionObserver(function (e) { if (e[0].isIntersecting) load(false); }, { rootMargin: '300px' }).observe(sentinel);
            load(true);

            // Search
            var typing;
            $('#searchText').on('input', function () { clearTimeout(typing); typing = setTimeout(function () { load(true); }, 350); });
            $('#filterForm').on('submit', function (e) { e.preventDefault(); load(true); });
            $('#resetBtn').on('click', function () { $('#searchText').val(''); load(true); });

            // Coming back to the tab after a while: show the latest customers
            var hiddenAt = 0;
            document.addEventListener('visibilitychange', function () {
                if (document.hidden) hiddenAt = Date.now();
                else if (hiddenAt && Date.now() - hiddenAt > 60000 && !modalEl.classList.contains('show')) load(true);
            });

            // ---------- Modal / form helpers ----------
            function parseForm() {
                var $form = $content.find('form');
                if ($form.length) { $form.removeData('validator').removeData('unobtrusiveValidation'); $.validator.unobtrusive.parse($form); }
            }

            function showAlert(message, type) {
                if (!message) return;
                $('#alertPlaceholder').html('<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show" role="alert">' + esc(message) +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            // Open modal: load Create / Edit / Details (delegated: works for rows added by scrolling)
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url'), size = $(this).data('size') || 'modal-lg';
                $.get(url)
                    .done(function (html) {
                        $dialog.removeClass('modal-sm modal-md modal-lg modal-xl').addClass(size);
                        $content.html(html);
                        parseForm();
                        modal.show();
                    })
                    .fail(function () { alert('Unable to load the form. Please try again.'); });
            });

            // Submit any form inside the modal via AJAX
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();
                var $form = $(this);
                if (!$form.valid()) return;
                var $btn = $form.find('[type=submit]').prop('disabled', true);

                $.post($form.attr('action'), $form.serialize())
                    .done(function (res) {
                        if (typeof res === 'object') {
                            modal.hide();
                            showAlert(res.message, res.success ? 'success' : 'danger');
                            if (res.success) load(true);
                        } else { $content.html(res); parseForm(); }   // validation errors: partial returned
                    })
                    .fail(function () { alert('Something went wrong. Please try again.'); })
                    .always(function () { $btn.prop('disabled', false); });
            });

            modalEl.addEventListener('hidden.bs.modal', function () { $content.empty(); });
        });
    </script>
}
