@model IEnumerable<Sales_Billing_System.Models.Customer_Master>
@using System.Linq

@{
    ViewBag.Title = "Customers";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Customer Master</h2>

            <p class="text-muted mb-0">
                Manage your customers and their information.
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "+ Add Customer",
                "Create",
                "Customer",
                null,
                new { @class = "btn btn-primary" }
            )
        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Search Section -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            @using (Html.BeginForm("Index", "Customer", FormMethod.Get))
            {
                <div class="row g-2 align-items-center">

                    <div class="col-md-9">

                        @Html.TextBox(
                            "searchText",
                            ViewBag.SearchText as string,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Search by customer name, mobile number or GSTIN..."
                            }
                        )

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Search
                        </button>

                    </div>

                    <div class="col-md-1">

                        @Html.ActionLink(
                            "Clear",
                            "Index",
                            "Customer",
                            null,
                            new { @class = "btn btn-secondary w-100" }
                        )

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- Customer Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>Id</th>

                            <th>Customer Name</th>

                            <th>Mobile Number</th>

                            <th>Address</th>

                            <th>GSTIN</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var customer in Model)
                            {
                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        <strong>
                                            @customer.CustomerName
                                        </strong>
                                    </td>

                                    <td>
                                        @customer.MobileNumber
                                    </td>

                                    <td>
                                        @customer.Address
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(customer.GSTIN))
                                        {
                                            @customer.GSTIN
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not Available
                                            </span>
                                        }

                                    </td>


                                    <td class="text-center">

                                        @Html.ActionLink(
                                            "Details",
                                            "Details",
                                            new { id = customer.CustomerId },
                                            new
                                            {
                                                @class = "btn btn-sm btn-info me-1"
                                            }
                                        )

                                        @Html.ActionLink(
                                            "Edit",
                                            "Edit",
                                            new { id = customer.CustomerId },
                                            new
                                            {
                                                @class = "btn btn-sm btn-warning"
                                            }
                                        )

                                    </td>

                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-4">

                                    <div class="text-muted">

                                        <h5>No Customers Found</h5>

                                        <p class="mb-0">
                                            There are currently no customers available.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>