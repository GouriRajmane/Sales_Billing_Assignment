@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Customer_Master>
@using System.Linq

@{
    ViewBag.Title = "Customers";
}

<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Customer Master</h2>
            <p class="text-muted mb-0">Manage your customers and their information.</p>
        </div>
        <div>
            <button type="button" class="btn btn-success btn-modal"
                    data-url="@Url.Action("Create", "Customer")">
                <i class="bi bi-plus-circle me-1"></i> Add Customer
            </button>
        </div>
    </div>

    <!-- Alert Placeholder (used by AJAX messages) -->
    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Search Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Customer", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label"><strong>Search</strong></label>
                        @Html.TextBox("searchText", ViewBag.SearchText as string,
                            new { @class = "form-control", placeholder = "Search by customer name, mobile number or GSTIN..." })
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill" title="Search">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                        <a href="@Url.Action("Index", "Customer")"
                           class="btn btn-outline-secondary" title="Reset filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Reloaded via AJAX after Create / Edit -->
    <div id="customerListContainer">

        <!-- Customer Table -->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-bordered">
                    <thead class="table-success">
                        <tr>
                            <th>Sr. No.</th>
                            <th>Customer Name</th>
                            <th>GSTIN</th>
                            <th>Mobile Number</th>
                            <th>Address</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items != null && Model.Items.Any())
                        {
                            int count = ((Model.CurrentPage - 1) * Model.PageSize) + 1;

                            foreach (var customer in Model.Items)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td><strong>@customer.CustomerName</strong></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(customer.GSTIN))
                                        {
                                            @customer.GSTIN
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Available</span>
                                        }
                                    </td>
                                    <td>@customer.MobileNumber</td>
                                    <td>@customer.Address</td>

                                    <td class="text-center text-nowrap">
                                        <button type="button"
                                                class="btn btn-sm btn-info text-white me-1 btn-modal"
                                                title="View Details"
                                                aria-label="View Details"
                                                data-url="@Url.Action("Details", "Customer", new { id = customer.CustomerId })">
                                            <i class="bi bi-info"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-warning me-1 btn-modal"
                                                title="Edit Customer"
                                                aria-label="Edit Customer"
                                                data-url="@Url.Action("Edit", "Customer", new { id = customer.CustomerId })">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="text-muted">
                                        <h5>No Customers Found</h5>
                                        <p class="mb-0">There are currently no customers available.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Load more -->
        @if (Model != null && Model.TotalRecords > 0)
        {
            <div id="loadMoreWrap" class="text-center my-4">
                <p class="text-muted mb-2">
                    Showing <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))</strong>
                    of <strong>@Model.TotalRecords</strong> customers
                </p>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <button type="button" id="loadMoreBtn" class="btn btn-outline-success px-4"
                            data-next-page="@(Model.CurrentPage + 1)"
                            data-page-size="@Model.PageSize">
                        <i class="bi bi-arrow-clockwise me-1"></i> Load more
                    </button>
                }
            </div>
        }

    </div> <!-- /customerListContainer -->

</div>

<!-- Shared Modal (Create / Edit / Details load here) -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {

            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog');
            var $content = $('#appModalContent');

            function parseForm() {
                var $form = $content.find('form');
                if ($form.length) {
                    $form.removeData('validator').removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse($form);
                }
            }

            function showAlert(message, type) {
                if (!message) return;

                $('#alertPlaceholder').html(
                    '<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show" role="alert">' +
                    $('<div>').text(message).html() +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '</div>');
            }

            // Load more: append the next page of rows under the current ones
            $(document).on('click', '#loadMoreBtn', function () {
                var $btn = $(this), original = $btn.html();
                var p = new URLSearchParams(window.location.search);
                p.set('page', $btn.data('next-page'));
                p.set('pageSize', $btn.data('page-size'));

                $btn.prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-2"></span>Loading...');

                $.get(window.location.pathname + '?' + p.toString())
                    .done(function (html) {
                        var $doc = $('<div>').append($.parseHTML(html));
                        $('#customerListContainer tbody').append($doc.find('#customerListContainer tbody tr'));
                        $('#loadMoreWrap').replaceWith($doc.find('#loadMoreWrap'));
                    })
                    .fail(function () {
                        $btn.prop('disabled', false).html(original);
                        showAlert('Unable to load more records. Please try again.', 'danger');
                    });
            });

            // Open modal: load Create / Edit / Details
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url');
                var size = $(this).data('size') || 'modal-lg';

                $.get(url)
                    .done(function (html) {
                        $dialog.removeClass('modal-sm modal-md modal-lg modal-xl').addClass(size);
                        $content.html(html);
                        parseForm();
                        modal.show();
                    })
                    .fail(function () {
                        alert('Unable to load the form. Please try again.');
                    });
            });

            // Submit any form inside the modal via AJAX
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();

                var $form = $(this);
                if (!$form.valid()) return;

                var $btn = $form.find('[type=submit]').prop('disabled', true);

                $.post($form.attr('action'), $form.serialize())
                    .done(function (res) {
                        if (typeof res === 'object') {
                            modal.hide();
                            showAlert(res.message, res.success ? 'success' : 'danger');

                            if (res.success) {
                                // Reload only the list, keeping current search
                                $('#customerListContainer')
                                    .load(window.location.href + ' #customerListContainer > *');
                            }
                        }
                        else {
                            // Validation failed: show form again with errors
                            $content.html(res);
                            parseForm();
                        }
                    })
                    .fail(function () {
                        alert('Something went wrong. Please try again.');
                    })
                    .always(function () {
                        $btn.prop('disabled', false);
                    });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                $content.empty();
            });
        });
    </script>
}