@model Sales_Billing_System.Models.Customer_Master


@using (Html.BeginForm("Create", "Customer", FormMethod.Post))
{
    @Html.AntiForgeryToken()

<div class="modal-header bg-dark text-white">
    <div>
        <h5 class="modal-title mb-0">Add Customer</h5>
        <small class="text-muted">Enter customer information to add a new customer.</small>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>

</div>
    
    <div class="modal-body">

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="row">

            <!-- Customer Name -->
            <div class="col-md-6 mb-3">
                @Html.LabelFor(model => model.CustomerName, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(model => model.CustomerName,
                    new { @class = "form-control", placeholder = "Enter customer name" })
                @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
            </div>

            <!-- GSTIN -->
            <div class="col-md-6 mb-3">
                @Html.LabelFor(model => model.GSTIN, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(model => model.GSTIN,
                    new { @class = "form-control", placeholder = "Enter GSTIN", maxlength = "15" })
                @Html.ValidationMessageFor(model => model.GSTIN, "", new { @class = "text-danger" })
            </div>

            <!-- Address -->
            <div class="col-md-12 mb-3">
                @Html.LabelFor(model => model.Address, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(model => model.Address,
                    new { @class = "form-control", rows = "4", placeholder = "Enter customer address" })
                @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
            </div>

            <!-- Mobile Number -->
            <div class="col-md-6 mb-3">
                @Html.LabelFor(model => model.MobileNumber, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(model => model.MobileNumber,
                    new { @class = "form-control", placeholder = "Enter mobile number", maxlength = "10" })
                @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Customer</button>
    </div>
}