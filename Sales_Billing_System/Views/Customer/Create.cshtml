@model Sales_Billing_System.Models.Customer_Master

@{
    ViewBag.Title = "Add Customer";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="mb-1">Add Customer</h2>
        <p class="text-muted mb-0">
            Enter customer information to add a new customer.
        </p>
    </div>

    <!-- Customer Form -->
    <div class="card shadow-sm">

        <div class="card-body">

            @using (Html.BeginForm("Create", "Customer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger mb-3" }
                )

                <div class="row">

                    <!-- Customer Name -->
                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                            model => model.CustomerName,
                            new { @class = "form-label fw-bold" }
                        )

                        @Html.TextBoxFor(
                            model => model.CustomerName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter customer name"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.CustomerName,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- Mobile Number -->
                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                            model => model.MobileNumber,
                            new { @class = "form-label fw-bold" }
                        )

                        @Html.TextBoxFor(
                            model => model.MobileNumber,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter mobile number",
                                maxlength = "15"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.MobileNumber,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- Address -->
                    <div class="col-md-12 mb-3">

                        @Html.LabelFor(
                            model => model.Address,
                            new { @class = "form-label fw-bold" }
                        )

                        @Html.TextAreaFor(
                            model => model.Address,
                            new
                            {
                                @class = "form-control",
                                rows = "4",
                                placeholder = "Enter customer address"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.Address,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>


                    <!-- GSTIN -->
                    <div class="col-md-6 mb-3">

                        @Html.LabelFor(
                            model => model.GSTIN,
                            new { @class = "form-label fw-bold" }
                        )

                        @Html.TextBoxFor(
                            model => model.GSTIN,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter GSTIN",
                                maxlength = "15"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.GSTIN,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Customer
                    </button>

                    @Html.ActionLink(
                        "Cancel",
                        "Index",
                        "Customer",
                        null,
                        new { @class = "btn btn-secondary ms-2" }
                    )

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}