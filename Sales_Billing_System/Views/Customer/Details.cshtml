@model Sales_Billing_System.Models.Customer_Master

@helper Row(string label, object value)
{
    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
        <span class="text-muted">@label</span>
        <span class="fw-semibold text-end">@value</span>
    </div>
}

@{
    string initial = string.IsNullOrWhiteSpace(Model.CustomerName) ? "?" : Model.CustomerName.Trim().Substring(0, 1).ToUpper();
    bool hasGstin = !string.IsNullOrWhiteSpace(Model.GSTIN);
}

<div class="modal-header bg-info text-white">
    <div>
        <h5 class="modal-title mb-0">Customer Details</h5>
        <small class="text-white">View complete customer information.</small>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">

    <!-- Name -->
    <div class="d-flex align-items-center mb-4">
        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fs-4 fw-bold me-3"
             style="width:56px; height:56px;">@initial</div>
            <div>
                <h4 class="mb-0">@Model.CustomerName</h4>
                <div class="text-muted small">Customer ID: @Model.CustomerId</div>
            </div>
        </div>

        <!-- Key figures -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="bg-light border rounded p-3 h-100">
                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>Mobile Number</div>
                    <div class="fs-5 fw-bold">@Model.MobileNumber</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="bg-light border rounded p-3 h-100">
                    <div class="small text-muted"><i class="bi bi-receipt me-1"></i>GSTIN</div>
                    <div class="fs-5 fw-bold">
                        @if (hasGstin)
                        {
                            @Model.GSTIN
                        }
                        else
                        {
                            <span class="text-muted fw-normal">Not Available</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Address -->
        <h6 class="text-uppercase small text-muted fw-bold mb-1">Address</h6>
        <div class="border rounded p-3" style="white-space: pre-line;">
            @if (string.IsNullOrWhiteSpace(Model.Address))
            {
                <span class="text-muted">Not Available</span>
            }
            else
            {
                @Model.Address
            }
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-warning btn-modal"
                data-url="@Url.Action("Edit", "Customer", new { id = Model.CustomerId })">
            <i class="bi bi-pencil-square me-1"></i> Edit Customer
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
