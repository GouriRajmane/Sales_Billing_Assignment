@model Sales_Billing_System.Models.Customer_Master

@{
    ViewBag.Title = "Customer Details";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="mb-1">Customer Details</h2>

        <p class="text-muted mb-0">
            View complete customer information.
        </p>

    </div>


    <!-- Customer Details Card -->
    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">
                Customer Information
            </h5>

        </div>


        <div class="card-body">

            <div class="row">

                <!-- Customer ID -->
                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        Customer ID
                    </label>

                    <div class="form-control bg-light">
                        @Model.CustomerId
                    </div>

                </div>


                <!-- Customer Name -->
                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        Customer Name
                    </label>

                    <div class="form-control bg-light">
                        @Model.CustomerName
                    </div>

                </div>


                <!-- Mobile Number -->
                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        Mobile Number
                    </label>

                    <div class="form-control bg-light">
                        @Model.MobileNumber
                    </div>

                </div>


                <!-- GSTIN -->
                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        GSTIN
                    </label>

                    <div class="form-control bg-light">

                        @if (!string.IsNullOrWhiteSpace(Model.GSTIN))
                        {
                            @Model.GSTIN
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Available
                            </span>
                        }

                    </div>

                </div>


                <!-- Address -->
                <div class="col-md-12 mb-3">

                    <label class="form-label fw-bold">
                        Address
                    </label>

                    <div class="form-control bg-light"
                         style="min-height: 100px;
                         height: auto;
                         white-space: pre-line;">

                        @Model.Address

                    </div>

                </div>

            </div>


            <!-- Buttons -->
            <div class="mt-3">

                @Html.ActionLink(
                    "Edit Customer",
                    "Edit",
                    "Customer",
                    new { id = Model.CustomerId },
                    new { @class = "btn btn-warning" }
                )

                @Html.ActionLink(
                    "Back to Customers",
                    "Index",
                    "Customer",
                    null,
                    new { @class = "btn btn-secondary ms-2" }
                )

            </div>

        </div>

    </div>

</div>