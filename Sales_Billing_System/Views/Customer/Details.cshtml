@model Sales_Billing_System.Models.Customer_Master

<div class="modal-header bg-info text-white">
    <div>
        <h5 class="modal-title mb-0">Customer Details</h5>
        <small class="text-white">View complete customer information.</small>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">

    <div class="row">

        <!-- Customer ID -->
        <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">Customer ID</label>
            <div class="form-control bg-light">@Model.CustomerId</div>
        </div>

        <!-- Customer Name -->
        <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">Customer Name</label>
            <div class="form-control bg-light">@Model.CustomerName</div>
        </div>

        <!-- Mobile Number -->
        <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">Mobile Number</label>
            <div class="form-control bg-light">@Model.MobileNumber</div>
        </div>

        <!-- GSTIN -->
        <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">GSTIN</label>
            <div class="form-control bg-light">
                @if (!string.IsNullOrWhiteSpace(Model.GSTIN))
                {
                    @Model.GSTIN
                }
                else
                {
                    <span class="text-muted">Not Available</span>
                }
            </div>
        </div>

        <!-- Address -->
        <div class="col-md-12 mb-3">
            <label class="form-label fw-bold">Address</label>
            <div class="form-control bg-light"
                 style="min-height: 100px; height: auto; white-space: pre-line;">@Model.Address</div>
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button"
                class="btn btn-warning btn-modal"
                data-url="@Url.Action("Edit", "Customer", new { id = Model.CustomerId })">
            Edit Customer
        </button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>