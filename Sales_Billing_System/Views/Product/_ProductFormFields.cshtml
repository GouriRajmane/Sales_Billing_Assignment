@model Sales_Billing_System.Models.Product_Master
@using System.Collections.Generic
@using System.Web.Mvc

@{
    // Only the CURRENTLY SELECTED value is rendered; everything else is
    // fetched on demand while the user types.
    var categoryItems = new List<SelectListItem>();
    if (Model.CategoryId > 0 && ViewBag.SelectedCategoryName != null)
    {
        categoryItems.Add(new SelectListItem
        {
            Value = Model.CategoryId.ToString(),
            Text = (string)ViewBag.SelectedCategoryName,
            Selected = true
        });
    }

    var subCategoryItems = new List<SelectListItem>();
    if (Model.SubCategoryId > 0 && ViewBag.SelectedSubCategoryName != null)
    {
        subCategoryItems.Add(new SelectListItem
        {
            Value = Model.SubCategoryId.ToString(),
            Text = (string)ViewBag.SelectedSubCategoryName,
            Selected = true
        });
    }

    var unitItems = new List<SelectListItem>();
    if (!string.IsNullOrWhiteSpace(Model.Unit))
    {
        unitItems.Add(new SelectListItem
        {
            Value = Model.Unit,
            Text = Model.Unit,
            Selected = true
        });
    }
}

<div class="row">

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.ProductName, new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.ProductName,
            new { @class = "form-control", placeholder = "Enter product name" })
        @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.SKU, new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.SKU,
            new { @class = "form-control", placeholder = "Enter SKU (Optional)" })
        @Html.ValidationMessageFor(m => m.SKU, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.CategoryId, "Category", new { @class = "form-label fw-bold" })
        @Html.DropDownListFor(m => m.CategoryId, categoryItems, "",
            new
            {
                @class = "form-select lookup-select",
                data_lookup = "category",
                data_url = Url.Action("SearchCategories", "Product"),
                data_placeholder = "Search category",
                data_search_message = "Search category...",
                data_val_required = "Please select a category."
            })
        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.SubCategoryId, "Sub Category", new { @class = "form-label fw-bold" })
        @Html.DropDownListFor(m => m.SubCategoryId, subCategoryItems, "",
            new
            {
                @class = "form-select lookup-select",
                data_lookup = "subcategory",
                data_url = Url.Action("SearchSubCategories", "Product"),
                data_placeholder = "Search subcategory",
                data_search_message = "Search subcategory...",
                data_val_required = "Please select a subcategory."
            })
        @Html.ValidationMessageFor(m => m.SubCategoryId, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.Unit, new { @class = "form-label fw-bold" })
        @Html.DropDownListFor(m => m.Unit, unitItems, "",
            new
            {
                @class = "form-select lookup-select",
                data_lookup = "unit",
                data_url = Url.Action("SearchUnits", "Product"),
                data_placeholder = "Search unit",
                data_search_message = "Search unit..."
            })
        @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.SellingPrice, new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.SellingPrice,
            new
            {
                @class = "form-control",
                type = "number",
                step = "0.01",
                min = "0.01",
                placeholder = "Enter selling price"
            })
        @Html.ValidationMessageFor(m => m.SellingPrice, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-6 mb-3">
        @Html.LabelFor(m => m.GSTPercentage, new { @class = "form-label fw-bold" })
        @Html.TextBoxFor(m => m.GSTPercentage,
            new
            {
                @class = "form-control",
                type = "number",
                step = "0.01",
                min = "0",
                max = "100",
                placeholder = "Enter GST percentage (Optional)"
            })
        @Html.ValidationMessageFor(m => m.GSTPercentage, "", new { @class = "text-danger" })
    </div>

</div>