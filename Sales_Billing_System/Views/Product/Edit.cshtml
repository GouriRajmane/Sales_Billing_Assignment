@model Sales_Billing_System.Models.Product_Master

@using (Html.BeginForm("Edit", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProductId)

    <div class="modal-header bg-warning text-dark">
        <div>
            <h5 class="modal-title mb-0">Edit Product</h5>
            <small>Update product details, category, pricing and GST.</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
       
        <div class="row">

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.CategoryId, "Category", new { @class = "form-label fw-bold" })
                <select id="CategoryId" name="CategoryId" class="form-select lazy-select"
                        data-url="@Url.Action("SearchCategories", "Product")"
                        data-placeholder="Search category..."
                        data-val="true" data-val-required="Please select a category.">
                    <option></option>
                    @if (Model.CategoryId > 0)
                    {
                        <option value="@Model.CategoryId" selected>@ViewBag.SelectedCategoryName</option>
                    }
                </select>
                @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.SubCategoryId, "SubCategory", new { @class = "form-label fw-bold" })
                <select id="SubCategoryId" name="SubCategoryId" class="form-select lazy-select"
                        data-url="@Url.Action("SearchSubCategories", "Product")"
                        data-parent="#CategoryId"
                        data-placeholder="Search subcategory..."
                        data-val="true" data-val-required="Please select a subcategory.">
                    <option></option>
                    @if (Model.SubCategoryId > 0)
                    {
                        <option value="@Model.SubCategoryId" selected>@ViewBag.SelectedSubCategoryName</option>
                    }
                </select>
                @Html.ValidationMessageFor(m => m.SubCategoryId, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.ProductName, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Enter product name", maxlength = "100" })
                @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.SKU, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.SKU, new { @class = "form-control", placeholder = "Enter SKU (optional)", maxlength = "50" })
                @Html.ValidationMessageFor(m => m.SKU, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.Unit, new { @class = "form-label fw-bold" })
                <select id="Unit" name="Unit" class="form-select lazy-select"
                        data-url="@Url.Action("SearchUnits", "Product")"
                        data-placeholder="Search unit..."
                        data-val="true" data-val-required="Please select a unit.">
                    <option></option>
                    @if (!string.IsNullOrWhiteSpace(Model.Unit))
                    {
                        <option selected>@Model.Unit</option>
                    }
                </select>
                @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.SellingPrice, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.SellingPrice, new { @class = "form-control", type = "number", step = "0.01", min = "0.01", placeholder = "Enter selling price" })
                @Html.ValidationMessageFor(m => m.SellingPrice, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.GSTPercentage, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.GSTPercentage, new { @class = "form-control", type = "number", step = "0.01", min = "0", max = "100", placeholder = "Enter GST percentage" })
                @Html.ValidationMessageFor(m => m.GSTPercentage, "", new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-1"></i> Update Product
        </button>
    </div>
}