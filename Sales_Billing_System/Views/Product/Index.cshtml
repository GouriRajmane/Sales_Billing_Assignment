@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Product_Master>
@using System.Linq

@{
    ViewBag.Title = "Products";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Product Master</h2>
            <p class="text-muted mb-0">Manage your products, pricing and GST information.</p>
        </div>
        <div>
            <button type="button"
                    class="btn btn-success btn-modal"
                    data-url="@Url.Action("Create", "Product")">
                + Add Product
            </button>
        </div>
    </div>

    <!-- Alert Placeholder (used by AJAX messages) -->
    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Search Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Product", FormMethod.Get))
            {
                <div class="row g-2 align-items-center">
                    <div class="col-md-9">
                        @Html.TextBox("searchText", ViewBag.SearchText as string,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Search by product name or SKU..."
                            })
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                    <div class="col-md-1">
                        @Html.ActionLink("Clear", "Index", "Product", null,
                            new { @class = "btn btn-secondary w-100" })
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Reloaded via AJAX after Create / Edit / Status change -->
    <div id="productListContainer">

        <!-- Product Table -->
        @*<div class="card shadow-sm">*@
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-bordered">
                        <thead class="table-success">
                            <tr>
                                <th>Sr.No.</th>
                                <th>Product Name</th>
                                <th>SKU</th>
                                <th>Category</th>
                                <th>Unit</th>
                                <th>Selling Price</th>
                                <th>GST %</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Items != null && Model.Items.Any())
                            {
                                int count = ((Model.CurrentPage - 1) * Model.PageSize) + 1;

                                foreach (var product in Model.Items)
                                {
                                    <tr>
                                        <td>@count</td>
                                        <td><strong>@product.ProductName</strong></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(product.SKU))
                                            {
                                                @product.SKU
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Available</span>
                                            }
                                        </td>
                                        <td>
                                            @if (product.Category != null &&
                                                 !string.IsNullOrWhiteSpace(product.Category.CategoryName))
                                            {
                                                @product.Category.CategoryName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Category not available</span>
                                            }
                                        </td>
                                        <td>@product.Unit</td>
                                        <td>₹ @product.SellingPrice.ToString("N2")</td>
                                        <td>@product.GSTPercentage.ToString("N2") %</td>
                                        <td>
                                            @if (product.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-sm btn-warning me-1 btn-modal"
                                                    data-url="@Url.Action("Edit", "Product", new { id = product.ProductId })">
                                                Edit
                                            </button>

                                            @if (product.IsActive)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-danger btn-modal"
                                                        data-size="modal-md"
                                                        data-url="@Url.Action("ConfirmToggleStatus", "Product", new { id = product.ProductId })">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-success btn-modal"
                                                        data-size="modal-md"
                                                        data-url="@Url.Action("ConfirmToggleStatus", "Product", new { id = product.ProductId })">
                                                    Activate
                                                </button>
                                            }
                                        </td>
                                    </tr>

                                    count++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <div class="text-muted">
                                            <h5>No Products Found</h5>
                                            <p class="mb-0">There are currently no products available.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        @*</div>*@

        <!-- Pagination -->
        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="row mt-4">

                <div class="col-md-6">
                    <p class="text-muted">
                        Showing
                        <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong>
                        -
                        <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))</strong>
                        of
                        <strong>@Model.TotalRecords</strong>
                        products
                    </p>
                </div>

                <div class="col-md-6 text-end">
                    <ul class="pagination justify-content-end">

                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Index", "Product", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, searchText = ViewBag.SearchText })">
                                    &laquo; Previous
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">&laquo; Previous</span>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", "Product", new { page = i, pageSize = Model.PageSize, searchText = ViewBag.SearchText })">
                                        @i
                                    </a>
                                </li>
                            }
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Index", "Product", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, searchText = ViewBag.SearchText })">
                                    Next &raquo;
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Next &raquo;</span>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        }

    </div> <!-- /productListContainer -->

</div>

<!-- Shared Modal (Create / Edit / Activate-Deactivate load here) -->
<div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {

            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog');
            var $content = $('#appModalContent');

            function parseForm() {
                var $form = $content.find('form');
                if ($form.length) {
                    $form.removeData('validator').removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse($form);
                }
            }

            function showAlert(message, type) {
                if (!message) return;

                $('#alertPlaceholder').html(
                    '<div class="alert alert-' + (type || 'success') + ' alert-dismissible fade show" role="alert">' +
                    $('<div>').text(message).html() +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '</div>');
            }

            // Open modal: load Create / Edit / ConfirmToggleStatus
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url');
                var size = $(this).data('size') || 'modal-lg';

                $.get(url)
                    .done(function (html) {
                        $dialog.removeClass('modal-sm modal-md modal-lg modal-xl').addClass(size);
                        $content.html(html);
                        parseForm();
                        modal.show();
                    })
                    .fail(function () {
                        alert('Unable to load the form. Please try again.');
                    });
            });

            // Submit any form inside the modal via AJAX
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();

                var $form = $(this);
                if (!$form.valid()) return;

                var $btn = $form.find('[type=submit]').prop('disabled', true);

                $.post($form.attr('action'), $form.serialize())
                    .done(function (res) {
                        if (typeof res === 'object') {
                            modal.hide();
                            showAlert(res.message, res.success ? 'success' : 'danger');

                            if (res.success) {
                                // Reload only the list, keeping current page and search
                                $('#productListContainer')
                                    .load(window.location.href + ' #productListContainer > *');
                            }
                        }
                        else {
                            // Validation failed: show form again with errors
                            $content.html(res);
                            parseForm();
                        }
                    })
                    .fail(function () {
                        alert('Something went wrong. Please try again.');
                    })
                    .always(function () {
                        $btn.prop('disabled', false);
                    });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                $content.empty();
            });
        });
    </script>
}