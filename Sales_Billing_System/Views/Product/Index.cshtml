@using System.Web.Mvc
@using System.Collections.Generic
@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Product_Master>
@using System.Linq

@{
    ViewBag.Title = "Products";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Product Master</h2>
            <p class="text-muted mb-0">Manage products, pricing, categories and GST.</p>
        </div>

        <button type="button"
                class="btn btn-success btn-modal"
                data-url="@Url.Action("Create", "Product")">
            <i class="bi bi-plus-circle me-1"></i> Add Product
        </button>
    </div>

    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Product", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label fw-bold" for="searchText">Search</label>

                        @Html.TextBox("searchText", ViewBag.SearchText as string,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Search by product name or SKU..."
                            })
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search me-1"></i> Search
                        </button>

                        <a href="@Url.Action("Index", "Product")"
                           class="btn btn-outline-secondary"
                           title="Reset search">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div id="productListContainer">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-success">
                            <tr>
                                <th>Sr.No.</th>
                                <th>Category</th>
                                <th>SubCategory</th>
                                <th>Product Name</th>
                                <th>SKU</th>
                                <th>Unit</th>
                                <th>Selling Price</th>
                                <th>GST %</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Items != null && Model.Items.Any())
                            {
                                int count = ((Model.CurrentPage - 1) * Model.PageSize) + 1;

                                foreach (var product in Model.Items)
                                {
                                    <tr>
                                        <td>@count</td>

                                        <td>
                                            @if (product.Category != null &&
                                                 !string.IsNullOrWhiteSpace(product.Category.CategoryName))
                                            {
                                                @product.Category.CategoryName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not assigned</span>
                                            }
                                        </td>

                                        <td>
                                            @if (product.SubCategory != null &&
                                                 !string.IsNullOrWhiteSpace(product.SubCategory.SubCategoryName))
                                            {
                                                @product.SubCategory.SubCategoryName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not assigned</span>
                                            }
                                        </td>

                                        <td><strong>@product.ProductName</strong></td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(product.SKU))
                                            {
                                                @product.SKU
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>

                                        <td>@product.Unit</td>
                                        <td>₹ @product.SellingPrice.ToString("N2")</td>
                                        <td>@product.GSTPercentage.ToString("N2") %</td>

                                        <td>
                                            @if (product.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>

                                        <td class="text-center text-nowrap">
                                            <button type="button"
                                                    class="btn btn-sm btn-info text-white me-1 btn-modal"
                                                    title="View Details"
                                                    data-url="@Url.Action("Details", "Product", new { id = product.ProductId })">
                                                <i class="bi bi-info"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-warning me-1 btn-modal"
                                                    title="Edit Product"
                                                    data-url="@Url.Action("Edit", "Product", new { id = product.ProductId })">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm @(product.IsActive ? "btn-danger" : "btn-success") btn-modal"
                                                    title="@(product.IsActive ? "Deactivate Product" : "Activate Product")"
                                                    data-size="modal-md"
                                                    data-url="@Url.Action("ConfirmToggleStatus", "Product", new { id = product.ProductId })">
                                                <i class="bi @(product.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    count++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5">
                                        <i class="bi bi-inbox fs-2 text-muted"></i>
                                        <h5 class="mt-2">No Products Found</h5>
                                        <p class="text-muted mb-0">
                                            Try another search or add a new product.
                                        </p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Load more -->
        @if (Model != null && Model.TotalRecords > 0)
        {
            <div id="loadMoreWrap" class="text-center my-4">
                <p class="text-muted mb-2">
                    Showing <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))</strong>
                    of <strong>@Model.TotalRecords</strong> products
                </p>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <button type="button" id="loadMoreBtn" class="btn btn-outline-success px-4"
                            data-next-page="@(Model.CurrentPage + 1)"
                            data-page-size="@Model.PageSize">
                        <i class="bi bi-arrow-clockwise me-1"></i> Load more
                    </button>
                }
            </div>
        }
    </div>
</div>

<div class="modal fade" id="appModal" tabindex="-1"
     aria-labelledby="appModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog');
            var $content = $('#appModalContent');

            // Search-as-you-type dropdowns (Category, SubCategory, Unit).
            // Nothing is loaded until the user types.
            function initLazySelects() {
                $content.find('.lazy-select').each(function () {
                    var $el = $(this);
                    var $parent = $($el.data('parent'));
                    var hint = $el.data('placeholder');

                    $el.select2({
                        theme: 'bootstrap-5',
                        dropdownParent: $('#appModal'),
                        width: '76%',
                        placeholder: hint,
                        minimumInputLength: 1,
                        language: {
                            inputTooShort: function () { return hint; },
                            noResults: function () { return 'No matches found'; },
                            searching: function () { return 'Searching...'; }
                        },
                        ajax: {
                            url: $el.data('url'),
                            dataType: 'json',
                            delay: 250,
                            data: function (params) {
                                var d = { term: params.term };
                                if ($parent.length) d.categoryId = $parent.val() || 0;
                                return d;
                            }
                        }
                    });

                    // SubCategory depends on Category: disabled until a category
                    // is chosen, and cleared whenever the category changes.
                    if ($parent.length) {
                        $el.prop('disabled', !$parent.val());

                        $parent.on('change', function () {
                            $el.empty().append('<option></option>')
                                .prop('disabled', !$parent.val())
                                .trigger('change');
                        });
                    }
                });
            }

            function prepareForm() {
                var $form = $content.find('form');

                if ($form.length) {
                    $form.removeData('validator')
                        .removeData('unobtrusiveValidation');

                    $.validator.unobtrusive.parse($form);
                }

                initLazySelects();
            }

            function showAlert(message, type) {
                if (!message) return;

                var safeMessage = $('<div>').text(message).html();

                $('#alertPlaceholder').html(
                    '<div class="alert alert-' + (type || 'success') +
                    ' alert-dismissible fade show" role="alert">' +
                    safeMessage +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '</div>'
                );
            }

            function loadProductList() {
                var url = window.location.pathname + window.location.search;

                $('#productListContainer').load(
                    url + ' #productListContainer > *'
                );
            }

            // Load more: append the next page of rows under the current ones
            $(document).on('click', '#loadMoreBtn', function () {
                var $btn = $(this), original = $btn.html();
                var p = new URLSearchParams(window.location.search);
                p.set('page', $btn.data('next-page'));
                p.set('pageSize', $btn.data('page-size'));

                $btn.prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-2"></span>Loading...');

                $.get(window.location.pathname + '?' + p.toString())
                    .done(function (html) {
                        var $doc = $('<div>').append($.parseHTML(html));
                        $('#productListContainer tbody').append($doc.find('#productListContainer tbody tr'));
                        $('#loadMoreWrap').replaceWith($doc.find('#loadMoreWrap'));
                    })
                    .fail(function () {
                        $btn.prop('disabled', false).html(original);
                        showAlert('Unable to load more records. Please try again.', 'danger');
                    });
            });

            // Load a modal partial.
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url');
                var size = $(this).data('size') || 'modal-lg';

                if (!url) return;

                $content.html(
                    '<div class="modal-body text-center py-5">' +
                    '<div class="spinner-border text-success" role="status"></div>' +
                    '<p class="mt-2 mb-0">Loading...</p></div>'
                );

                $dialog.removeClass('modal-sm modal-md modal-lg modal-xl')
                    .addClass(size);

                modal.show();

                $.get(url)
                    .done(function (html) {
                        $content.html(html);
                        prepareForm();
                    })
                    .fail(function () {
                        $content.html(
                            '<div class="modal-body">' +
                            '<div class="alert alert-danger mb-0">' +
                            'Unable to load this page. Please try again.' +
                            '</div></div>'
                        );
                    });
            });

            // Submit Create/Edit/Status forms using AJAX.
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();

                var $form = $(this);

                if ($form.data('submitting')) return;

                if ($form.valid && !$form.valid()) return;

                var $submitButton = $form.find('[type="submit"]');
                var originalHtml = $submitButton.html();

                $form.data('submitting', true);
                $submitButton.prop('disabled', true).text('Please wait...');

                $.ajax({
                    url: $form.attr('action'),
                    type: ($form.attr('method') || 'POST').toUpperCase(),
                    data: $form.serialize()
                })
                    .done(function (res) {
                        if (res && typeof res === 'object' &&
                            Object.prototype.hasOwnProperty.call(res, 'success')) {

                            if (res.success) {
                                modal.hide();
                                showAlert(res.message || 'Product saved successfully.', 'success');
                                loadProductList();
                            } else {
                                showAlert(res.message || 'Unable to save the product.', 'danger');
                            }
                        } else {
                            // The server returned the partial view with validation errors.
                            $content.html(res);
                            prepareForm();
                        }
                    })
                    .fail(function () {
                        showAlert('The request failed. Please check your input and try again.', 'danger');
                    })
                    .always(function () {
                        $form.removeData('submitting');
                        $submitButton.prop('disabled', false).html(originalHtml);
                    });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                $content.empty();
            });
        });
    </script>
}