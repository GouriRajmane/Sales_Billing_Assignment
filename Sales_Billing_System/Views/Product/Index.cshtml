@model IEnumerable<Sales_Billing_System.Models.Product_Master>
@using System.Linq

@{
    ViewBag.Title = "Product List";
}
<div class="container">

    <div class="row">

        <div class="col-md-12">

            <div class="panel panel-primary">

                <div class="panel-heading">
                    <div class="row">

                        <div class="col-md-6">
                            <h3 class="panel-title">
                                Product Master
                            </h3>
                        </div>

                        <div class="col-md-6 text-right">
                            @Html.ActionLink(
                                "Add New Product",
                                "Create",
                                "Product",
                                null,
                                new { @class = "btn btn-success btn-sm" }
                            )
                        </div>

                    </div>
                </div>


                <div class="panel-body">

                    <!-- Success Message -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible">

                            <button type="button"
                                    class="close"
                                    data-dismiss="alert">
                                &times;
                            </button>

                            @TempData["SuccessMessage"]

                        </div>
                    }


                    <!-- Error Message -->
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible">

                            <button type="button"
                                    class="close"
                                    data-dismiss="alert">
                                &times;
                            </button>

                            @TempData["ErrorMessage"]

                        </div>
                    }


                    <!-- Search Form -->
                    @using (Html.BeginForm(
                        "Index",
                        "Product",
                        FormMethod.Get,
                        new { @class = "form-inline" }))
                    {
                        <div class="form-group">

                            <input type="text"
                                   name="searchText"
                                   value="@ViewBag.SearchText"
                                   class="form-control"
                                   placeholder="Search by Product Name or SKU" />

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Search
                        </button>

                        @Html.ActionLink(
                            "Clear",
                            "Index",
                            "Product",
                            null,
                            new { @class = "btn btn-default" }
                        )
                    }

                    <hr />


                    <!-- Product Table -->
                    <div class="table-responsive">

                        <table class="table table-bordered table-hover">

                            <thead>

                                <tr>

                                    <th>Product ID</th>

                                    <th>Product Name</th>

                                    <th>SKU</th>

                                    <th>Unit</th>

                                    <th>Selling Price</th>

                                    <th>GST %</th>

                                    <th>Status</th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model != null && Model.Any())
                                {
                                    foreach (var product in Model)
                                    {
                                        <tr>

                                            <td>
                                                @product.ProductId
                                            </td>

                                            <td>
                                                @product.ProductName
                                            </td>

                                            <td>
                                                @(string.IsNullOrEmpty(product.SKU)
                                                    ? "-"
                                                    : product.SKU)
                                            </td>

                                            <td>
                                                @product.Unit
                                            </td>

                                            <td>
                                                ₹ @product.SellingPrice.ToString("N2")
                                            </td>

                                            <td>
                                                @product.GSTPercentage %
                                            </td>


                                            <td>

                                                @if (product.IsActive)
                                                {
                                                    <span class="label label-success">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="label label-danger">
                                                        Inactive
                                                    </span>
                                                }

                                            </td>


                                            <td class="text-center">

                                                @Html.ActionLink(
                                                    "Edit",
                                                    "Edit",
                                                    new { id = product.ProductId },
                                                    new
                                                    {
                                                        @class = "btn btn-warning btn-sm"
                                                    }
                                                )


                                                @using (Html.BeginForm(
                                                    "ToggleStatus",
                                                    "Product",
                                                    new { id = product.ProductId },
                                                    FormMethod.Post,
                                                    new
                                                    {
                                                        @style = "display:inline;"
                                                    }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    if (product.IsActive)
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-danger btn-sm"
                                                                onclick="return confirm('Are you sure you want to deactivate this product?');">
                                                            Deactivate
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-success btn-sm"
                                                                onclick="return confirm('Are you sure you want to activate this product?');">
                                                            Activate
                                                        </button>
                                                    }
                                                }

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="8"
                                            class="text-center text-muted">

                                            No products found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>