@using System.Web.Mvc
@using System.Collections.Generic
@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Product_Master>
@using System.Linq

@{
    ViewBag.Title = "Products";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Product Master</h2>
            <p class="text-muted mb-0">Manage products, pricing, categories and GST.</p>
        </div>

        <button type="button"
                class="btn btn-success btn-modal"
                data-url="@Url.Action("Create", "Product")">
            <i class="bi bi-plus-circle me-1"></i> Add Product
        </button>
    </div>

    <div id="alertPlaceholder">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Product", FormMethod.Get))
            {
                <div class="row g-2 align-items-end">
                    <div class="col-md-9">
                        <label class="form-label fw-bold" for="searchText">Search</label>

                        @Html.TextBox("searchText", ViewBag.SearchText as string,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Search by product name or SKU..."
                            })
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="bi bi-search me-1"></i> Search
                        </button>

                        <a href="@Url.Action("Index", "Product")"
                           class="btn btn-outline-secondary"
                           title="Reset search">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div id="productListContainer">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-success">
                            <tr>
                                <th>Sr.No.</th>
                                <th>Category</th>
                                <th>SubCategory</th>
                                <th>Product Name</th>
                                <th>SKU</th>
                                <th>Unit</th>
                                <th>Selling Price</th>
                                <th>GST %</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Items != null && Model.Items.Any())
                            {
                                int count = ((Model.CurrentPage - 1) * Model.PageSize) + 1;

                                foreach (var product in Model.Items)
                                {
                                    <tr>
                                        <td>@count</td>

                                        <td>
                                            @if (product.Category != null &&
                                                 !string.IsNullOrWhiteSpace(product.Category.CategoryName))
                                            {
                                                @product.Category.CategoryName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not assigned</span>
                                            }
                                        </td>

                                        <td>
                                            @if (product.SubCategory != null &&
                                                 !string.IsNullOrWhiteSpace(product.SubCategory.SubCategoryName))
                                            {
                                                @product.SubCategory.SubCategoryName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not assigned</span>
                                            }
                                        </td>

                                        <td><strong>@product.ProductName</strong></td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(product.SKU))
                                            {
                                                @product.SKU
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>

                                        <td>@product.Unit</td>
                                        <td>₹ @product.SellingPrice.ToString("N2")</td>
                                        <td>@product.GSTPercentage.ToString("N2") %</td>

                                        <td>
                                            @if (product.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>

                                        <td class="text-center text-nowrap">
                                            <button type="button"
                                                    class="btn btn-sm btn-info text-white me-1 btn-modal"
                                                    title="View Details"
                                                    data-url="@Url.Action("Details", "Product", new { id = product.ProductId })">
                                                <i class="bi bi-info"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-warning me-1 btn-modal"
                                                    title="Edit Product"
                                                    data-url="@Url.Action("Edit", "Product", new { id = product.ProductId })">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm @(product.IsActive ? "btn-danger" : "btn-success") btn-modal"
                                                    title="@(product.IsActive ? "Deactivate Product" : "Activate Product")"
                                                    data-size="modal-md"
                                                    data-url="@Url.Action("ConfirmToggleStatus", "Product", new { id = product.ProductId })">
                                                <i class="bi @(product.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    count++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5">
                                        <i class="bi bi-inbox fs-2 text-muted"></i>
                                        <h5 class="mt-2">No Products Found</h5>
                                        <p class="text-muted mb-0">
                                            Try another search or add a new product.
                                        </p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="row mt-4 align-items-center">
                <div class="col-md-6">
                    <p class="text-muted mb-2">
                        Showing
                        <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong>
                        -
                        <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))</strong>
                        of <strong>@Model.TotalRecords</strong> products
                    </p>
                </div>

                <div class="col-md-6">
                    <nav aria-label="Product pagination">
                        <ul class="pagination justify-content-md-end flex-wrap">

                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                @if (Model.CurrentPage > 1)
                                {
                                    <a class="page-link"
                                       href="@Url.Action("Index", "Product", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, searchText = ViewBag.SearchText })">
                                        &laquo; Previous
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">&laquo; Previous</span>
                                }
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    @if (i == Model.CurrentPage)
                                    {
                                        <span class="page-link">@i</span>
                                    }
                                    else
                                    {
                                        <a class="page-link"
                                           href="@Url.Action("Index", "Product", new { page = i, pageSize = Model.PageSize, searchText = ViewBag.SearchText })">
                                            @i
                                        </a>
                                    }
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <a class="page-link"
                                       href="@Url.Action("Index", "Product", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, searchText = ViewBag.SearchText })">
                                        Next &raquo;
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">Next &raquo;</span>
                                }
                            </li>

                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="appModal" tabindex="-1"
     aria-labelledby="appModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" id="appModalDialog">
        <div class="modal-content" id="appModalContent"></div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {
            $.ajaxSetup({ cache: false });

            var modalEl = document.getElementById('appModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            var $dialog = $('#appModalDialog');
            var $content = $('#appModalContent');

            function parseForm() {
                var $form = $content.find('form');

                if ($form.length) {
                    $form.removeData('validator')
                        .removeData('unobtrusiveValidation');

                    $.validator.unobtrusive.parse($form);
                }
            }

            function showAlert(message, type) {
                if (!message) return;

                var safeMessage = $('<div>').text(message).html();

                $('#alertPlaceholder').html(
                    '<div class="alert alert-' + (type || 'success') +
                    ' alert-dismissible fade show" role="alert">' +
                    safeMessage +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                    '</div>'
                );
            }

            function loadProductList() {
                var url = window.location.pathname + window.location.search;

                $('#productListContainer').load(
                    url + ' #productListContainer > *'
                );
            }

            // Load a modal partial.
            $(document).on('click', '.btn-modal', function () {
                var url = $(this).data('url');
                var size = $(this).data('size') || 'modal-lg';

                if (!url) return;

                $content.html(
                    '<div class="modal-body text-center py-5">' +
                    '<div class="spinner-border text-success" role="status"></div>' +
                    '<p class="mt-2 mb-0">Loading...</p></div>'
                );

                $dialog.removeClass('modal-sm modal-md modal-lg modal-xl')
                    .addClass(size);

                modal.show();

                $.get(url)
                    .done(function (html) {
                        $content.html(html);
                        parseForm();
                    })
                    .fail(function () {
                        $content.html(
                            '<div class="modal-body">' +
                            '<div class="alert alert-danger mb-0">' +
                            'Unable to load this page. Please try again.' +
                            '</div></div>'
                        );
                    });
            });

            // Reload subcategories when Category changes.
            $(document).on('change', '#CategoryId', function () {
                var $category = $(this);
                var categoryId = $category.val();
                var $form = $category.closest('form');
                var $subCategory = $form.find('#SubCategoryId');

                var url = $category.attr('data-subcategory-url');

                $subCategory.empty()
                    .append($('<option>', {
                        value: '',
                        text: '-- Select SubCategory --'
                    }))
                    .prop('disabled', true);

                if (!categoryId || !url) {
                    $subCategory.prop('disabled', !categoryId);
                    return;
                }

                $.getJSON(url, { categoryId: categoryId })
                    .done(function (items) {
                        $.each(items || [], function (_, item) {
                            $subCategory.append($('<option>', {
                                value: item.Value !== undefined ? item.Value : item.value,
                                text: item.Text !== undefined ? item.Text : item.text
                            }));
                        });

                        $subCategory.prop('disabled', false);
                    })
                    .fail(function () {
                        showAlert('Unable to load subcategories for the selected category.', 'danger');
                    });
            });

            // Submit Create/Edit/Status forms using AJAX.
            $(document).on('submit', '#appModalContent form', function (e) {
                e.preventDefault();

                var $form = $(this);

                if ($form.data('submitting')) return;

                if ($form.valid && !$form.valid()) return;

                var $submitButton = $form.find('[type="submit"]');
                var originalText = $submitButton.text();

                $form.data('submitting', true);
                $submitButton.prop('disabled', true).text('Please wait...');

                $.ajax({
                    url: $form.attr('action'),
                    type: ($form.attr('method') || 'POST').toUpperCase(),
                    data: $form.serialize()
                })
                    .done(function (res) {
                        if (res && typeof res === 'object' &&
                            Object.prototype.hasOwnProperty.call(res, 'success')) {

                            if (res.success) {
                                modal.hide();
                                showAlert(res.message || 'Product saved successfully.', 'success');
                                loadProductList();
                            } else {
                                showAlert(res.message || 'Unable to save the product.', 'danger');
                            }
                        } else {
                            // The server returned the partial view with validation errors.
                            $content.html(res);
                            parseForm();
                        }
                    })
                    .fail(function () {
                        showAlert('The request failed. Please check your input and try again.', 'danger');
                    })
                    .always(function () {
                        $form.removeData('submitting');
                        $submitButton.prop('disabled', false).text(originalText);
                    });
            });

            modalEl.addEventListener('hidden.bs.modal', function () {
                $content.empty();
            });
        });
    </script>
}
