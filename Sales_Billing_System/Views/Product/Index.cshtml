
@model Sales_Billing_System.Models.PagedResult<Sales_Billing_System.Models.Product_Master>

@using System.Linq

@{
    ViewBag.Title = "Products";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Product Master</h2>

            <p class="text-muted mb-0">
                Manage your products, pricing and GST information.
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "+ Add Product",
                "Create",
                "Product",
                null,
                new { @class = "btn btn-primary" }
            )
        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {

            <div class="alert alert-success alert-dismissible fade show" role="alert">

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
            }


            <!-- Error Message -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- Search Section -->
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    @using (Html.BeginForm(
                        "Index",
                        "Product",
                        FormMethod.Get))
                    {
                        <div class="row g-2 align-items-center">

                            <div class="col-md-9">

                                @Html.TextBox(
                                    "searchText",
                                    ViewBag.SearchText as string,
                                    new
                                    {
                                        @class = "form-control",
                                        placeholder = "Search by product name or SKU..."
                                    }
                                )

                            </div>

                            <div class="col-md-2">

                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    Search
                                </button>

                            </div>

                            <div class="col-md-1">

                                @Html.ActionLink(
                                    "Clear",
                                    "Index",
                                    "Product",
                                    null,
                                    new
                                    {
                                        @class = "btn btn-secondary w-100"
                                    }
                                )

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- Product Table -->
            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-dark">

                                <tr>

                                    <th>
                                        Sr. No.
                                    </th>

                                    <th>
                                        Product Name
                                    </th>

                                    <th>
                                        SKU
                                    </th>

                                    <th>
                                        Unit
                                    </th>

                                    <th>
                                        Selling Price
                                    </th>

                                    <th>
                                        GST %
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model != null &&
                                     Model.Items != null &&
                                     Model.Items.Any())
                                {
                                    int count =
                                        ((Model.CurrentPage - 1) *
                                        Model.PageSize) + 1;

                                    foreach (var product in Model.Items)
                                    {
                                        <tr>

                                            <!-- Serial Number -->
                                            <td>
                                                @count
                                            </td>


                                            <!-- Product Name -->
                                            <td>
                                                <strong>
                                                    @product.ProductName
                                                </strong>
                                            </td>


                                            <!-- SKU -->
                                            <td>

                                                @if (!string.IsNullOrWhiteSpace(product.SKU))
                                                {
                                                    @product.SKU
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Not Available
                                                    </span>
                                                }

                                            </td>


                                            <!-- Unit -->
                                            <td>
                                                @product.Unit
                                            </td>


                                            <!-- Selling Price -->
                                            <td>
                                                ₹ @product.SellingPrice.ToString("N2")
                                            </td>


                                            <!-- GST -->
                                            <td>
                                                @product.GSTPercentage.ToString("N2") %
                                            </td>


                                            <!-- Status -->
                                            <td>

                                                @if (product.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        Inactive
                                                    </span>
                                                }

                                            </td>


                                            <!-- Actions -->
                                            <td class="text-center">

                                                @Html.ActionLink(
                                                    "Details",
                                                    "Details",
                                                    new
                                                    {
                                                        id = product.ProductId
                                                    },
                                                    new
                                                    {
                                                        @class = "btn btn-sm btn-info me-1"
                                                    }
                                                )

                                                @Html.ActionLink(
                                                    "Edit",
                                                    "Edit",
                                                    new
                                                    {
                                                        id = product.ProductId
                                                    },
                                                    new
                                                    {
                                                        @class = "btn btn-sm btn-warning me-1"
                                                    }
                                                )


                                                @using (Html.BeginForm(
                                                    "ToggleStatus",
                                                    "Product",
                                                    new
                                                    {
                                                        id = product.ProductId
                                                    },
                                                    FormMethod.Post,
                                                    new
                                                    {
                                                        @class = "d-inline"
                                                    }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    if (product.IsActive)
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-danger"
                                                                onclick="return confirm('Are you sure you want to deactivate this product?');">
                                                            Deactivate
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit"
                                                                class="btn btn-sm btn-success"
                                                                onclick="return confirm('Are you sure you want to activate this product?');">
                                                            Activate
                                                        </button>
                                                    }
                                                }

                                            </td>

                                        </tr>

                                        count++;
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="8"
                                            class="text-center py-4">

                                            <div class="text-muted">

                                                <h5>
                                                    No Products Found
                                                </h5>

                                                <p class="mb-0">
                                                    There are currently no products available.
                                                </p>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>


            <!-- =========================
         PAGINATION
    ========================== -->

            @if (Model != null && Model.TotalPages > 0)
            {
                <div class="row mt-4">

                    <!-- Record Information -->
                    <div class="col-md-6">

                        <p class="text-muted">

                            Showing

                            <strong>
                                @(((Model.CurrentPage - 1) *
                        Model.PageSize) + 1)
                            </strong>

                            -

                            <strong>
                                @(Math.Min(
                            Model.CurrentPage *
                            Model.PageSize,
                            Model.TotalRecords))
                            </strong>

                            of

                            <strong>
                                @Model.TotalRecords
                            </strong>

                            products

                        </p>

                    </div>


                    <!-- Pagination -->
                    <div class="col-md-6 text-end">

                        <ul class="pagination justify-content-end">

                            <!-- Previous -->
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       href="@Url.Action(
                                   "Index",
                                   "Product",
                                   new
                                   {
                                       page =
                                           Model.CurrentPage - 1,

                                       pageSize =
                                           Model.PageSize,

                                       searchText =
                                           ViewBag.SearchText
                                   })">

                                        &laquo; Previous

                                    </a>

                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        &laquo; Previous
                                    </span>

                                </li>
                            }


                            <!-- Page Numbers -->
                            @for (
                                int i = 1;
                                i <= Model.TotalPages;
                                i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <li class="page-item active">

                                        <span class="page-link">
                                            @i
                                        </span>

                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">

                                        <a class="page-link"
                                           href="@Url.Action(
                                       "Index",
                                       "Product",
                                       new
                                       {
                                           page = i,

                                           pageSize =
                                               Model.PageSize,

                                           searchText =
                                               ViewBag.SearchText
                                       })">

                                            @i

                                        </a>

                                    </li>
                                }
                            }


                            <!-- Next -->
                            @if (Model.CurrentPage <
                                Model.TotalPages)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       href="@Url.Action(
                                   "Index",
                                   "Product",
                                   new
                                   {
                                       page =
                                           Model.CurrentPage + 1,

                                       pageSize =
                                           Model.PageSize,

                                       searchText =
                                           ViewBag.SearchText
                                   })">

                                        Next &raquo;

                                    </a>

                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        Next &raquo;
                                    </span>

                                </li>
                            }

                        </ul>

                    </div>

                </div>
            }

        </div>
