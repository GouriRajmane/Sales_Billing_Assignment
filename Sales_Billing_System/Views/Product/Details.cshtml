@model Sales_Billing_System.Models.Product_Master

@helper Field(string label, object value)
{
    <div class="col-md-6 mb-3">
        <label class="form-label fw-bold">@label</label>
        <div class="form-control bg-light">@value</div>
    </div>
}

<div class="modal-header bg-info text-white">
    <div>
        <h5 class="modal-title mb-0">Product Details</h5>
        <small>Complete product information.</small>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="row">
        @Field("Product ID", Model.ProductId)
        @Field("Product Name", Model.ProductName)
        @Field("Category", Model.Category != null ? Model.Category.CategoryName : "Not assigned")
        @Field("SubCategory", Model.SubCategory != null ? Model.SubCategory.SubCategoryName : "Not assigned")
        @Field("SKU", string.IsNullOrWhiteSpace(Model.SKU) ? "N/A" : Model.SKU)
        @Field("Unit", string.IsNullOrWhiteSpace(Model.Unit) ? "N/A" : Model.Unit)
        @Field("Selling Price", "₹ " + Model.SellingPrice.ToString("N2"))
        @Field("GST Percentage", Model.GSTPercentage.ToString("N2") + " %")
        @Field("Status", Html.Raw(Model.IsActive
            ? "<span class='badge bg-success'>Active</span>"
            : "<span class='badge bg-danger'>Inactive</span>"))
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-warning btn-modal"
            data-url="@Url.Action("Edit", "Product", new { id = Model.ProductId })">
        <i class="bi bi-pencil-square me-1"></i> Edit Product
    </button>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>