@model Sales_Billing_System.Models.Product_Master

@{
    ViewBag.Title = "Add Product";
}

<div class="container">

    <div class="row">
        <div class="col-md-8 col-md-offset-2">

            <div class="panel panel-primary">

                <div class="panel-heading">
                    <h3 class="panel-title">Add New Product</h3>
                </div>

                <div class="panel-body">

                    @using (Html.BeginForm("Create", "Product", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(
                            true,
                            "",
                            new { @class = "text-danger" })

                        <div class="form-group">

                            @Html.LabelFor(m => m.ProductName)

                            @Html.TextBoxFor(
                                m => m.ProductName,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter product name"
                                })

                            @Html.ValidationMessageFor(
                                m => m.ProductName,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(m => m.SKU)

                            @Html.TextBoxFor(
                                m => m.SKU,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter SKU (Optional)"
                                })

                            @Html.ValidationMessageFor(
                                m => m.SKU,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(m => m.Unit)

                            @Html.TextBoxFor(
                                m => m.Unit,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Example: Piece, Kg, Box"
                                })

                            @Html.ValidationMessageFor(
                                m => m.Unit,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(m => m.SellingPrice)

                            @Html.TextBoxFor(
                                m => m.SellingPrice,
                                new
                                {
                                    @class = "form-control",
                                    type = "number",
                                    step = "0.01",
                                    min = "0.01",
                                    placeholder = "Enter selling price"
                                })

                            @Html.ValidationMessageFor(
                                m => m.SellingPrice,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <div class="form-group">

                            @Html.LabelFor(m => m.GSTPercentage)

                            @Html.TextBoxFor(
                                m => m.GSTPercentage,
                                new
                                {
                                    @class = "form-control",
                                    type = "number",
                                    step = "0.01",
                                    min = "0",
                                    max = "100",
                                    placeholder = "Enter GST percentage (Optional)"
                                })

                            @Html.ValidationMessageFor(
                                m => m.GSTPercentage,
                                "",
                                new { @class = "text-danger" })

                        </div>


                        <hr />

                        <button type="submit"
                                class="btn btn-primary">
                            Save Product
                        </button>

                        @Html.ActionLink(
                            "Cancel",
                            "Index",
                            "Product",
                            null,
                            new { @class = "btn btn-default" })
                    }

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}