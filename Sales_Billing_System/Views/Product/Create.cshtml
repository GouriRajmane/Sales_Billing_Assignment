@model Sales_Billing_System.Models.Product_Master

@using (Html.BeginForm("Create", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()

<div class="modal-header bg-success text-white">
    <div>
        <h5 class="modal-title mb-0">Add New Product</h5>
        <small class="text-white">Enter product details, pricing and GST information.</small>
    </div>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>

</div>

    <div class="modal-body">

        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="row">

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.ProductName, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.ProductName,
                    new { @class = "form-control", placeholder = "Enter product name" })
                @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.SKU, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.SKU,
                    new { @class = "form-control", placeholder = "Enter SKU (Optional)" })
                @Html.ValidationMessageFor(m => m.SKU, "", new { @class = "text-danger" })
            </div>


            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.CategoryId, "Category", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.Categories,
                   "-- Select Category --", new { @class = "form-select", required = "required" })
                @Html.ValidationMessageFor(m => m.CategoryId, "",
                    new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.Unit, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Unit, (SelectList)ViewBag.Units,
                    "-- Select Unit --", new { @class = "form-select", required = "required" })
                @Html.ValidationMessageFor(m => m.Unit, "",
                    new { @class = "text-danger" })
            </div>


            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.SellingPrice, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.SellingPrice,
                    new
                    {
                        @class = "form-control",
                        type = "number",
                        step = "0.01",
                        min = "0.01",
                        placeholder = "Enter selling price"
                    })
                @Html.ValidationMessageFor(m => m.SellingPrice, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.GSTPercentage, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.GSTPercentage,
                    new
                    {
                        @class = "form-control",
                        type = "number",
                        step = "0.01",
                        min = "0",
                        max = "100",
                        placeholder = "Enter GST percentage (Optional)"
                    })
                @Html.ValidationMessageFor(m => m.GSTPercentage, "", new { @class = "text-danger" })
            </div>

        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success">Save Product</button>
    </div>
}