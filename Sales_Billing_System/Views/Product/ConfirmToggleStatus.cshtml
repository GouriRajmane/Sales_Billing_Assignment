@model Sales_Billing_System.Models.Product_Master

@using (Html.BeginForm("ToggleStatus", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ProductId, new { Name = "id" })

    <div class="modal-header bg-dark text-white">
        <h5 class="modal-title mb-0">
            @(Model.IsActive ? "Deactivate Product" : "Activate Product")
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <p class="mb-1">
            Are you sure you want to
            <strong>@(Model.IsActive ? "deactivate" : "activate")</strong>
            this product?
        </p>
        <p class="mb-0 text-muted">
            @Model.ProductName
            @if (!string.IsNullOrWhiteSpace(Model.SKU))
            {
                <span>(@Model.SKU)</span>
            }
        </p>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn @(Model.IsActive ? "btn-danger" : "btn-success")">
            @(Model.IsActive ? "Yes, Deactivate" : "Yes, Activate")
        </button>
    </div>
}